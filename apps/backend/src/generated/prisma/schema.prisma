generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String                   @map("password_hash")
  name                    String
  role                    Role                     @default(MEMBER)
  orgUnitId               String?                  @map("org_unit_id")
  refreshToken            String?                  @map("refresh_token")
  isActive                Boolean                  @default(true) @map("is_active")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  bugAttachments          BugAttachment[]
  bugComments             BugComment[]             @relation("BugCommentAuthor")
  assignedBugs            Bug[]                    @relation("BugAssignee")
  pmApprovedBugs          Bug[]                    @relation("BugPMApprover")
  reportedBugs            Bug[]                    @relation("BugReporter")
  employee                Employee?
  notifications           Notification[]
  startedProcesses        ProcessInstance[]        @relation("ProcessInstanceStarter")
  assignedProcessTasks    ProcessUserTask[]        @relation("ProcessTaskAssignee")
  ledProjects             Project[]                @relation("ProjectPM")
  pushTokens              PushToken[]
  taskApprovals           Task[]                   @relation("TaskApprover")
  timeEntries             TimeEntry[]
  timeLogs                TimeLog[]
  approvedTimesheets      TimesheetRecord[]        @relation("TimesheetApprover")
  timesheets              TimesheetRecord[]        @relation("TimesheetOwner")
  moduleRoles             UserModuleRole[]
  userPermissions         UserPermission[]
  groupMemberships        GroupMembership[]
  approvedLeaves          LeaveRequest[]           @relation("LeaveApprover")
  processedPayrolls       PayrollPeriod[]          @relation("PayrollProcessor")
  submittedExpenses       Expense[]                @relation("ExpenseSubmitter")
  approvedExpenses        Expense[]                @relation("ExpenseApprover")
  orgUnit                 OrgUnit?                 @relation(fields: [orgUnitId], references: [id])
  workStatuses            WorkStatus[]
  auditLogs               AuditLog[]
  crmActivities           CrmActivity[]            @relation("CrmActivityCreator")
  okrObjectives           OkrObjective[]           @relation("OkrObjectiveOwner")
  kbArticles              KbArticle[]              @relation("KbArticleAuthor")
  poRequests              PurchaseOrder[]          @relation("PoRequester")
  poApprovals             PurchaseOrder[]          @relation("PoApprover")
  comments                Comment[]                @relation("CommentAuthor")
  feedPosts               FeedPost[]               @relation("FeedPostAuthor")
  feedReactions           FeedReaction[]           @relation("FeedReactions")
  roomBookings            RoomBooking[]            @relation("RoomBooker")
  vehicles                Vehicle[]                @relation("VehicleDriver")
  vehicleRequests         VehicleRequest[]         @relation("VehicleRequester")
  vehicleApprovals        VehicleRequest[]         @relation("VehicleApprover")
  calendarEvents          CalendarEvent[]          @relation("CalendarEventCreator")
  approvedOvertimes       OvertimeRequest[]        @relation("OtApprover")
  tenantId                String?                  @map("tenant_id")
  tenant                  Tenant?                  @relation(fields: [tenantId], references: [id])
  delegatorRules          DelegationRule[]         @relation("DelegatorRules")
  delegateRules           DelegationRule[]         @relation("DelegateRules")
  salaryReviewApprovals   SalaryReviewSuggestion[] @relation("SalaryReviewApprover")
  projectJournals         ProjectJournal[]         @relation("JournalCreator")
  leadFollowUpSchedules   LeadFollowUpSchedule[]
  customerSurveySchedules CustomerSurveySchedule[]

  @@map("users")
}

model OrgUnit {
  id                 String              @id @default(uuid())
  name               String
  code               String
  parentId           String?             @map("parent_id")
  level              Int                 @default(0)
  headJobTitleId     String?             @map("head_job_title_id")
  leaderId           String?             @unique @map("leader_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  employees          Employee[]
  positions          Position[]
  parent             OrgUnit?            @relation("OrgTree", fields: [parentId], references: [id])
  children           OrgUnit[]           @relation("OrgTree")
  headJobTitle       JobTitle?           @relation(fields: [headJobTitleId], references: [id], onDelete: SetNull)
  leader             Employee?           @relation("OrgUnitLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  processDefinitions ProcessDefinition[]
  projects           Project[]
  users              User[]
  groupOrgAccess     GroupOrgAccess[]
  assets             Asset[]
  tenantId           String?             @map("tenant_id")
  tenant             Tenant?             @relation("TenantOrgUnits", fields: [tenantId], references: [id])
  budgetPlans        BudgetPlan[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("org_units")
}

model Employee {
  id                 String                     @id @default(uuid())
  code               String
  userId             String?                    @unique @map("user_id")
  orgUnitId          String                     @map("org_unit_id")
  fullName           String                     @map("full_name")
  birthdate          DateTime?                  @db.Date
  techStack          String[]                   @map("tech_stack")
  level              EmployeeLevel              @default(JUNIOR)
  cccd               String?
  cccdIssueDate      DateTime?                  @map("cccd_issue_date") @db.Date
  cccdIssuePlace     String?                    @map("cccd_issue_place")
  startDate          DateTime                   @map("start_date") @db.Date
  endDate            DateTime?                  @map("end_date") @db.Date
  isActive           Boolean                    @default(true) @map("is_active")
  employeeStatus     EmployeeStatus             @default(ACTIVE) @map("employee_status")
  positionId         String?                    @map("position_id")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  email              String?                    @unique
  allocations        Allocation[]
  contracts          Contract[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  payrollRecords     PayrollRecord[]
  rates              EmployeeRate[]
  orgUnit            OrgUnit                    @relation(fields: [orgUnitId], references: [id])
  user               User?                      @relation(fields: [userId], references: [id])
  tasks              Task[]                     @relation("TaskAssignee")
  assetAssignments   AssetAssignment[]
  trainingRecords    TrainingRecord[]
  performanceReviews PerformanceReview[]        @relation("ReviewSubject")
  reviewsAsReviewer  PerformanceReview[]        @relation("Reviewer")
  taxProfile         EmployeeTaxProfile?
  yearlySummaries    EmployeeYearlyTaxSummary[]

  skills                  EmployeeSkill[]
  position                Position?                @relation(fields: [positionId], references: [id])
  hrDecisions             HrDecision[]
  workHistories           WorkHistory[]
  salaryRecords           SalaryRecord[]
  positionHistories       PositionHistory[]
  directManagerId         String?                  @map("direct_manager_id")
  directManager           Employee?                @relation("DirectReport", fields: [directManagerId], references: [id], onDelete: SetNull)
  directReports           Employee[]               @relation("DirectReport")
  leadingOrgUnit          OrgUnit?                 @relation("OrgUnitLeader")
  overtimeRequests        OvertimeRequest[]
  signedContracts         Contract[]               @relation("ContractSigner")
  tenantId                String?                  @map("tenant_id")
  tenant                  Tenant?                  @relation("TenantEmployees", fields: [tenantId], references: [id])
  deletedAt               DateTime?                @map("deleted_at")
  leavePolicyId           String?                  @map("leave_policy_id")
  leavePolicy             LeavePolicy?             @relation(fields: [leavePolicyId], references: [id])
  idType                  IdType?                  @map("id_type")
  idNumber                String?                  @map("id_number")
  idIssueDate             DateTime?                @map("id_issue_date") @db.Date
  idIssuePlace            String?                  @map("id_issue_place")
  permanentAddress        String?                  @map("permanent_address")
  currentAddress          String?                  @map("current_address")
  ethnicity               String?
  religion                String?
  nationality             String?
  bankAccount             String?                  @map("bank_account")
  bankName                String?                  @map("bank_name")
  insuranceEnrollments    InsuranceEnrollment[]
  socialInsuranceBook     SocialInsuranceBook?
  attendanceRecords       AttendanceRecord[]
  monthlyAttendances      MonthlyAttendance[]
  shiftAssignments        ShiftAssignment[]
  workScheduleEnrollments WorkScheduleEnrollment[]
  submittedExpenses       Expense[]                @relation("ExpenseEmployee")
  performanceBonuses      PerformanceBonus[]
  approvedBonuses         PerformanceBonus[]       @relation("BonusApprover")
  costBreakdowns          ProjectCostByEmployee[]
  salaryReviews           SalaryReviewSuggestion[] @relation("EmployeeSalaryReviews")
  attendanceExplanations  AttendanceExplanation[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("employees")
}

model Skill {
  id          String          @id @default(uuid())
  name        String          @unique
  category    SkillCategory   @default(TECHNICAL)
  description String?
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  employees   EmployeeSkill[]

  @@map("skills")
}

model EmployeeSkill {
  id          String     @id @default(uuid())
  employeeId  String     @map("employee_id")
  skillId     String     @map("skill_id")
  level       SkillLevel @default(BEGINNER)
  yearsExp    Float      @default(0) @map("years_exp")
  notes       String?
  certifiedAt DateTime?  @map("certified_at") @db.Date
  updatedAt   DateTime   @updatedAt @map("updated_at")
  employee    Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill       Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeId, skillId])
  @@map("employee_skills")
}

enum SkillCategory {
  TECHNICAL
  SOFT
  LANGUAGE
  DOMAIN
  CERTIFICATION

  @@map("skill_category")
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT

  @@map("skill_level")
}

model EmployeeRate {
  id            String         @id @default(uuid())
  employeeId    String         @map("employee_id")
  ratePerDay    Decimal        @map("rate_per_day") @db.Decimal(12, 2)
  currency      BudgetCurrency @default(VND)
  effectiveDate DateTime       @map("effective_date") @db.Date
  createdAt     DateTime       @default(now()) @map("created_at")
  employee      Employee       @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, effectiveDate])
  @@map("employee_rates")
}

model Project {
  id               String                @id @default(uuid())
  name             String
  code             String
  type             ProjectType
  status           ProjectStatus         @default(PLANNING)
  pmId             String                @map("pm_id")
  orgUnitId        String                @map("org_unit_id")
  startDate        DateTime              @map("start_date") @db.Date
  endDate          DateTime              @map("end_date") @db.Date
  customerId       String?               @map("customer_id")
  budgetHours      Decimal?              @map("budget_hours") @db.Decimal(10, 2)
  budgetCost       Decimal?              @map("budget_cost") @db.Decimal(15, 2)
  budgetEffortMm   Decimal?              @map("budget_effort_mm") @db.Decimal(8, 2)
  currency         BudgetCurrency        @default(VND)
  progress         Decimal               @default(0) @db.Decimal(5, 2)
  description      String?
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  alertConfigs     AlertConfig[]
  members          Allocation[]
  bugs             Bug[]
  expenses         Expense[]
  processInstances ProcessInstance[]
  orgUnit          OrgUnit               @relation(fields: [orgUnitId], references: [id])
  pm               User                  @relation("ProjectPM", fields: [pmId], references: [id])
  tasks            Task[]
  customer         Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tenantId         String?               @map("tenant_id")
  tenant           Tenant?               @relation("TenantProjects", fields: [tenantId], references: [id])
  deletedAt        DateTime?             @map("deleted_at")
  budgetPlans      BudgetPlan[]          @relation("BudgetPlanProject")
  costSnapshots    ProjectCostSnapshot[]
  journals         ProjectJournal[]
  crmActivities    CrmActivity[]         @relation("ProjectCrmActivities")

  @@unique([tenantId, code])
  @@index([customerId])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("projects")
}

model Allocation {
  id            String        @id @default(uuid())
  projectId     String        @map("project_id")
  employeeId    String        @map("employee_id")
  role          String        @default("MEMBER")
  level         EmployeeLevel @default(JUNIOR)
  allocationPct Decimal       @map("allocation_pct") @db.Decimal(5, 2)
  ratePerDay    Decimal?      @map("rate_per_day") @db.Decimal(12, 2)
  startDate     DateTime      @map("start_date") @db.Date
  endDate       DateTime      @map("end_date") @db.Date
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  employee      Employee      @relation(fields: [employeeId], references: [id])
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("TenantAllocations", fields: [tenantId], references: [id])

  @@unique([projectId, employeeId, startDate])
  @@index([tenantId])
  @@map("allocations")
}

model Task {
  id               String            @id @default(uuid())
  projectId        String            @map("project_id")
  parentId         String?           @map("parent_id")
  level            Int               @default(1)
  title            String
  description      String?
  status           TaskStatus        @default(TODO)
  assigneeId       String?           @map("assignee_id")
  approverId       String?           @map("approver_id")
  startDate        DateTime?         @map("start_date") @db.Date
  dueDate          DateTime?         @map("due_date") @db.Date
  estimateHours    Decimal           @default(0) @map("estimate_hours") @db.Decimal(8, 2)
  actualHours      Decimal           @default(0) @map("actual_hours") @db.Decimal(8, 2)
  progress         Decimal           @default(0) @db.Decimal(5, 2)
  position         Int               @default(0)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  bugLinks         BugTask[]
  approver         User?             @relation("TaskApprover", fields: [approverId], references: [id])
  assignee         Employee?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  parent           Task?             @relation("TaskTree", fields: [parentId], references: [id])
  children         Task[]            @relation("TaskTree")
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  telegramMessages TelegramMessage[]
  timeLogs         TimeLog[]
  tenantId         String?           @map("tenant_id")
  tenant           Tenant?           @relation("TenantTasks", fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("tasks")
}

model TimeLog {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  logDate   DateTime @map("log_date") @db.Date
  hours     Decimal  @db.Decimal(5, 2)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@map("time_logs")
}

model WorkStatus {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  statusType WorkStatusType @map("status_type")
  startedAt  DateTime       @map("started_at")
  endedAt    DateTime?      @map("ended_at")
  note       String?
  createdAt  DateTime       @default(now()) @map("created_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc)])
  @@map("work_statuses")
}

model TimeEntry {
  id                 String        @id @default(uuid())
  userId             String        @map("user_id")
  date               DateTime      @db.Date
  checkInAt          DateTime?     @map("check_in_at")
  checkOutAt         DateTime?     @map("check_out_at")
  checkInLat         Decimal?      @map("check_in_lat") @db.Decimal(10, 7)
  checkInLng         Decimal?      @map("check_in_lng") @db.Decimal(10, 7)
  checkOutLat        Decimal?      @map("check_out_lat") @db.Decimal(10, 7)
  checkOutLng        Decimal?      @map("check_out_lng") @db.Decimal(10, 7)
  checkInMethod      CheckInMethod @default(MANUAL) @map("check_in_method")
  isManualCorrection Boolean       @default(false) @map("is_manual_correction")
  correctionReason   String?       @map("correction_reason")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("TenantTimeEntries", fields: [tenantId], references: [id])

  @@unique([userId, date])
  @@index([tenantId])
  @@map("time_entries")
}

model TimesheetRecord {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  periodStart     DateTime        @map("period_start") @db.Date
  periodEnd       DateTime        @map("period_end") @db.Date
  workingDays     Decimal         @default(0) @map("working_days") @db.Decimal(5, 2)
  standardDays    Decimal         @default(0) @map("standard_days") @db.Decimal(5, 2)
  overtimeHours   Decimal         @default(0) @map("overtime_hours") @db.Decimal(7, 2)
  otWeekdayHours  Decimal         @default(0) @map("ot_weekday_hours") @db.Decimal(7, 2)
  otWeekendHours  Decimal         @default(0) @map("ot_weekend_hours") @db.Decimal(7, 2)
  otHolidayHours  Decimal         @default(0) @map("ot_holiday_hours") @db.Decimal(7, 2)
  leaveDays       Decimal         @default(0) @map("leave_days") @db.Decimal(5, 2)
  unpaidLeaveDays Decimal         @default(0) @map("unpaid_leave_days") @db.Decimal(5, 1)
  status          TimesheetStatus @default(DRAFT)
  submittedAt     DateTime?       @map("submitted_at")
  approvedAt      DateTime?       @map("approved_at")
  approvedById    String?         @map("approved_by_id")
  rejectionReason String?         @map("rejection_reason")
  lockedAt        DateTime?       @map("locked_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  approvedBy      User?           @relation("TimesheetApprover", fields: [approvedById], references: [id])
  user            User            @relation("TimesheetOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([userId, periodStart])
  @@map("timesheet_records")
}

model AlertConfig {
  id            String           @id @default(uuid())
  projectId     String           @map("project_id")
  type          NotificationType
  threshold     Decimal?         @db.Decimal(5, 2)
  daysBeforeDue Int?             @map("days_before_due")
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@map("alert_configs")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  body       String
  isRead     Boolean          @default(false) @map("is_read")
  link       String?          @db.VarChar(500)
  payload    Json?
  createdAt  DateTime         @default(now()) @map("created_at")
  entityId   String?          @map("entity_id")
  entityType String?          @map("entity_type")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

model TelegramConfig {
  id        String   @id @default(uuid())
  botToken  String   @map("bot_token")
  chatId    String   @map("chat_id")
  isEnabled Boolean  @default(false) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("telegram_configs")
}

model TelegramMessage {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  eventType String   @map("event_type")
  messageId Int      @map("message_id")
  sentDate  DateTime @default(now()) @map("sent_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, eventType, sentDate])
  @@map("telegram_messages")
}

model ProcessDefinition {
  id             String            @id @default(uuid())
  key            String?
  name           String
  description    String?
  version        Int               @default(1)
  bpmnXml        String            @map("bpmn_xml")
  orgUnitId      String            @map("org_unit_id")
  status         DefinitionStatus  @default(DRAFT)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  formFields     Json?             @map("form_fields")
  taskFormFields Json?             @map("task_form_fields")
  stepConfig     Json?             @map("step_config")
  orgUnit        OrgUnit           @relation(fields: [orgUnitId], references: [id])
  instances      ProcessInstance[]
  tenantId       String?           @map("tenant_id")
  tenant         Tenant?           @relation("TenantProcessDefinitions", fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([orgUnitId])
  @@index([status])
  @@index([tenantId])
  @@map("process_definitions")
}

model ProcessInstance {
  id               String               @id @default(uuid())
  definitionId     String               @map("definition_id")
  projectId        String?              @map("project_id")
  startedBy        String               @map("started_by")
  status           InstanceStatus       @default(RUNNING)
  variables        Json                 @default("{}")
  tokenState       Json                 @default("{}") @map("token_state")
  startedAt        DateTime             @default(now()) @map("started_at")
  completedAt      DateTime?            @map("completed_at")
  activityLog      ProcessActivityLog[]
  definition       ProcessDefinition    @relation(fields: [definitionId], references: [id])
  project          Project?             @relation(fields: [projectId], references: [id])
  startedByUser    User                 @relation("ProcessInstanceStarter", fields: [startedBy], references: [id])
  userTasks        ProcessUserTask[]
  leaveRequests    LeaveRequest[]
  expenses         Expense[]
  overtimeRequests OvertimeRequest[]

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("TenantProcessInstances", fields: [tenantId], references: [id])

  @@index([definitionId, status])
  @@index([startedBy])
  @@index([projectId])
  @@index([tenantId])
  @@map("process_instances")
}

model ProcessUserTask {
  id             String          @id @default(uuid())
  instanceId     String          @map("instance_id")
  activityId     String          @map("activity_id")
  name           String
  assigneeId     String?         @map("assignee_id")
  candidateRoles String[]        @default([]) @map("candidate_roles")
  formData       Json?           @map("form_data")
  status         UserTaskStatus  @default(PENDING)
  dueDate        DateTime?       @map("due_date")
  completedAt    DateTime?       @map("completed_at")
  assignee       User?           @relation("ProcessTaskAssignee", fields: [assigneeId], references: [id])
  instance       ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([assigneeId, status])
  @@map("process_user_tasks")
}

model ProcessActivityLog {
  id           String          @id @default(uuid())
  instanceId   String          @map("instance_id")
  activityId   String          @map("activity_id")
  activityName String          @map("activity_name")
  activityType String          @map("activity_type")
  performedBy  String?         @map("performed_by")
  startedAt    DateTime        @default(now()) @map("started_at")
  completedAt  DateTime?       @map("completed_at")
  instance     ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@map("process_activity_logs")
}

model Bug {
  id             String          @id @default(uuid())
  projectId      String          @map("project_id")
  reporterId     String          @map("reporter_id")
  assigneeId     String?         @map("assignee_id")
  title          String
  description    String?
  severity       BugSeverity     @default(MEDIUM)
  status         BugStatus       @default(OPEN)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  affectedModule String?         @map("affected_module")
  approvalNote   String?         @map("approval_note")
  approvedAt     DateTime?       @map("approved_at")
  closedAt       DateTime?       @map("closed_at")
  dueDate        DateTime?       @map("due_date")
  estimatedHours Int?            @map("estimated_hours")
  isCR           Boolean         @default(false) @map("is_cr")
  itemType       BugItemType     @default(BUG) @map("item_type")
  pmApproverId   String?         @map("pm_approver_id")
  requesterName  String?         @map("requester_name")
  resolutionNote String?         @map("resolution_note")
  resolvedAt     DateTime?       @map("resolved_at")
  attachments    BugAttachment[]
  comments       BugComment[]
  tags           BugTag[]
  tasks          BugTask[]
  assignee       User?           @relation("BugAssignee", fields: [assigneeId], references: [id])
  pmApprover     User?           @relation("BugPMApprover", fields: [pmApproverId], references: [id])
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter       User            @relation("BugReporter", fields: [reporterId], references: [id])
  tenantId       String?         @map("tenant_id")
  tenant         Tenant?         @relation("TenantBugs", fields: [tenantId], references: [id])
  deletedAt      DateTime?       @map("deleted_at")

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([reporterId])
  @@index([itemType, status])
  @@index([dueDate])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("bugs")
}

model BugTask {
  bugId  String @map("bug_id")
  taskId String @map("task_id")
  bug    Bug    @relation(fields: [bugId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([bugId, taskId])
  @@map("bug_tasks")
}

model BugAttachment {
  id          String   @id @default(uuid())
  bugId       String   @map("bug_id")
  uploaderId  String   @map("uploader_id")
  filename    String
  storagePath String   @map("storage_path")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")
  bug         Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  uploader    User     @relation(fields: [uploaderId], references: [id])

  @@index([bugId])
  @@map("bug_attachments")
}

model BugComment {
  id        String   @id @default(uuid())
  bugId     String   @map("bug_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  author    User     @relation("BugCommentAuthor", fields: [authorId], references: [id])
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@index([bugId])
  @@map("bug_comments")
}

model BugTag {
  bugId String @map("bug_id")
  tag   String
  bug   Bug    @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@id([bugId, tag])
  @@map("bug_tags")
}

model Permission {
  code                  String                 @id
  module                String
  action                String
  description           String?
  createdAt             DateTime               @default(now()) @map("created_at")
  moduleRolePermissions ModuleRolePermission[]
  rolePermissions       RolePermission[]
  userPermissions       UserPermission[]
  screens               Screen[]

  @@map("permissions")
}

// ─── Screen Registry ──────────────────────────────────────────────────────────
// Source of truth: synced từ screens.registry.ts khi seed/deploy.
// Admin chỉ đọc (không tạo/xóa) — dev khai báo trong registry.

model Screen {
  id        String   @id @default(uuid())
  module    String // pm | hr | finance | bpm | timesheet | reports | admin
  route     String   @unique // /projects | /contracts | ...
  label     String // Dự án | Hợp đồng | ...
  icon      String?
  permCode  String?  @map("perm_code") // null = public route
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permission Permission? @relation(fields: [permCode], references: [code], onDelete: SetNull)

  @@map("screens")
}

model RolePermission {
  role           Role
  permissionCode String     @map("permission_code")
  createdAt      DateTime   @default(now()) @map("created_at")
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([role, permissionCode])
  @@map("role_permissions")
}

model UserPermission {
  userId         String     @map("user_id")
  permissionCode String     @map("permission_code")
  granted        Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionCode])
  @@map("user_permissions")
}

model ModuleRole {
  code        String                 @id
  name        String
  domain      String
  description String?
  isSystem    Boolean                @default(false) @map("is_system")
  createdAt   DateTime               @default(now()) @map("created_at")
  permissions ModuleRolePermission[]
  userRoles   UserModuleRole[]

  @@map("module_roles")
}

model ModuleRolePermission {
  roleCode       String     @map("role_code")
  permissionCode String     @map("permission_code")
  createdAt      DateTime   @default(now()) @map("created_at")
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)
  role           ModuleRole @relation(fields: [roleCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@map("module_role_permissions")
}

model UserModuleRole {
  userId    String     @map("user_id")
  roleCode  String     @map("role_code")
  createdAt DateTime   @default(now()) @map("created_at")
  role      ModuleRole @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleCode])
  @@map("user_module_roles")
}

