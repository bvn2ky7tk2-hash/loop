  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  vehicle         Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  requestedBy     User                 @relation("VehicleRequester", fields: [requestedById], references: [id])
  approvedBy      User?                @relation("VehicleApprover", fields: [approvedById], references: [id])

  @@index([vehicleId, startTime, endTime])
  @@index([requestedById])
  @@index([status])
  @@map("vehicle_requests")
}

// ─── Epic E17: Budget Management ─────────────────────────────────────────────

model BudgetPlan {
  id             String           @id @default(uuid())
  name           String
  fiscalYear     Int              @map("fiscal_year")
  type           BudgetPlanType   @default(DEPARTMENT)
  status         BudgetPlanStatus @default(DRAFT)
  orgUnitId      String?          @map("org_unit_id")
  projectId      String?          @map("project_id")
  totalAmount    Decimal          @map("total_amount") @db.Decimal(15, 2)
  note           String?
  createdById    String?          @map("created_by_id")
  approvedById   String?          @map("approved_by_id")
  approvedAt     DateTime?        @map("approved_at")
  rejectedReason String?          @map("rejected_reason")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  lines          BudgetLine[]
  orgUnit        OrgUnit?         @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  project        Project?         @relation("BudgetPlanProject", fields: [projectId], references: [id], onDelete: SetNull)

  @@index([fiscalYear])
  @@index([orgUnitId])
  @@index([status])
  @@map("budget_plans")
}

model BudgetLine {
  id              String              @id @default(uuid())
  planId          String              @map("plan_id")
  category        String
  description     String?
  allocatedAmount Decimal             @map("allocated_amount") @db.Decimal(15, 2)
  usedAmount      Decimal             @default(0) @map("used_amount") @db.Decimal(15, 2)
  committedAmount Decimal             @default(0) @map("committed_amount") @db.Decimal(15, 2)
  alertThreshold  Int                 @default(80) @map("alert_threshold")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  plan            BudgetPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  transactions    BudgetTransaction[]

  @@index([planId])
  @@index([category])
  @@map("budget_lines")
}

model BudgetTransaction {
  id         String                @id @default(uuid())
  lineId     String                @map("line_id")
  sourceType String                @map("source_type")
  sourceId   String                @map("source_id")
  amount     Decimal               @db.Decimal(15, 2)
  type       BudgetTransactionType @default(ACTUAL)
  note       String?
  createdAt  DateTime              @default(now()) @map("created_at")
  line       BudgetLine            @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@index([sourceType, sourceId])
  @@map("budget_transactions")
}

enum BudgetPlanType {
  DEPARTMENT
  PROJECT
  COMPANY

  @@map("budget_plan_type")
}

enum BudgetPlanStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  CLOSED

  @@map("budget_plan_status")
}

enum BudgetTransactionType {
  ACTUAL
  COMMITTED

  @@map("budget_transaction_type")
}

// ─── E19.1 — Performance Bonus ────────────────────────────────────────────────

/// Cấu hình thưởng theo dải điểm đánh giá
model PerformanceBonusConfig {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  label       String   @db.VarChar(100)
  scoreMin    Decimal  @map("score_min") @db.Decimal(4, 1)
  scoreMax    Decimal  @map("score_max") @db.Decimal(4, 1)
  /// Hệ số nhân với lương cơ bản
  coefficient Decimal  @db.Decimal(5, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("performance_bonus_configs")
}

enum BonusStatus {
  DRAFT
  APPROVED
  PAID

  @@map("bonus_status")
}

/// Bản ghi thưởng hiệu suất cho từng kỳ đánh giá
model PerformanceBonus {
  id           String      @id @default(uuid())
  tenantId     String?     @map("tenant_id")
  employeeId   String      @map("employee_id")
  reviewId     String      @map("review_id")
  score        Decimal     @db.Decimal(3, 1)
  baseSalary   Decimal     @map("base_salary") @db.Decimal(15, 2)
  coefficient  Decimal     @db.Decimal(5, 2)
  bonusAmount  Decimal     @map("bonus_amount") @db.Decimal(15, 2)
  status       BonusStatus @default(DRAFT)
  note         String?
  approvedById String?     @map("approved_by_id")
  approvedAt   DateTime?   @map("approved_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  review     PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  approvedBy Employee?         @relation("BonusApprover", fields: [approvedById], references: [id])

  @@unique([reviewId, employeeId])
  @@index([employeeId])
  @@index([tenantId])
  @@map("performance_bonuses")
}

// ─── Company Calendar ──────────────────────────────────────────────────────────

enum CalendarEventType {
  MEETING
  HOLIDAY
  TRAINING
  DEADLINE
  OTHER

  @@map("calendar_event_type")
}

model CalendarEvent {
  id          String            @id @default(uuid())
  title       String            @db.VarChar(300)
  description String?           @db.Text
  eventType   CalendarEventType @default(MEETING) @map("event_type")
  startTime   DateTime          @map("start_time")
  endTime     DateTime          @map("end_time")
  isAllDay    Boolean           @default(false) @map("is_all_day")
  location    String?           @db.VarChar(300)
  color       String?           @db.VarChar(20)
  createdById String            @map("created_by_id")
  attendees   String[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  createdBy   User              @relation("CalendarEventCreator", fields: [createdById], references: [id])

  @@index([startTime, endTime])
  @@map("calendar_events")
}

model DelegationRule {
  id          String   @id @default(uuid())
  delegatorId String   @map("delegator_id")
  delegateId  String   @map("delegate_id")
  moduleTypes String[] @map("module_types")
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  isActive    Boolean  @default(true) @map("is_active")
  note        String?
  tenantId    String?  @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")
  delegator   User     @relation("DelegatorRules", fields: [delegatorId], references: [id])
  delegate    User     @relation("DelegateRules", fields: [delegateId], references: [id])
  tenant      Tenant?  @relation("TenantDelegations", fields: [tenantId], references: [id])

  @@index([delegatorId, isActive])
  @@index([delegateId, isActive])
  @@map("delegation_rules")
}

model InvoiceAccountMapping {
  id              String          @id @default(uuid())
  tenantId        String?         @map("tenant_id")
  invoiceType     String          @map("invoice_type")
  debitAccountId  String          @map("debit_account_id")
  creditAccountId String          @map("credit_account_id")
  vatAccountId    String?         @map("vat_account_id")
  debitAccount    ChartOfAccount  @relation("MappingDebit", fields: [debitAccountId], references: [id])
  creditAccount   ChartOfAccount  @relation("MappingCredit", fields: [creditAccountId], references: [id])
  vatAccount      ChartOfAccount? @relation("MappingVat", fields: [vatAccountId], references: [id])
  tenant          Tenant?         @relation("TenantInvoiceMappings", fields: [tenantId], references: [id])

  @@unique([tenantId, invoiceType])
  @@map("invoice_account_mappings")
}

model ProjectCostSnapshot {
  id                String                  @id @default(uuid())
  projectId         String                  @map("project_id")
  snapshotDate      DateTime                @map("snapshot_date") @db.Date
  totalLaborCost    Decimal                 @default(0) @map("total_labor_cost") @db.Decimal(18, 2)
  totalExpenseCost  Decimal                 @default(0) @map("total_expense_cost") @db.Decimal(18, 2)
  totalCost         Decimal                 @default(0) @map("total_cost") @db.Decimal(18, 2)
  billableHours     Decimal                 @default(0) @map("billable_hours") @db.Decimal(10, 2)
  totalHours        Decimal                 @default(0) @map("total_hours") @db.Decimal(10, 2)
  utilizationRate   Decimal                 @default(0) @map("utilization_rate") @db.Decimal(5, 2)
  createdAt         DateTime                @default(now()) @map("created_at")
  project           Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeBreakdown ProjectCostByEmployee[]

  @@unique([projectId, snapshotDate])
  @@index([projectId])
  @@index([snapshotDate])
  @@map("project_cost_snapshots")
}

model ProjectCostByEmployee {
  id          String              @id @default(uuid())
  snapshotId  String              @map("snapshot_id")
  employeeId  String              @map("employee_id")
  hours       Decimal             @db.Decimal(10, 2)
  ratePerHour Decimal             @map("rate_per_hour") @db.Decimal(12, 2)
  cost        Decimal             @db.Decimal(18, 2)
  snapshot    ProjectCostSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  employee    Employee            @relation(fields: [employeeId], references: [id])

  @@index([snapshotId])
  @@map("project_cost_by_employees")
}

// ─── Project Journal ─────────────────────────────────────────────────────────

model ProjectJournal {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  date            DateTime @db.Date
  startTime       String?  @map("start_time")
  endTime         String?  @map("end_time")
  title           String   @db.VarChar(300)
  location        String?  @db.VarChar(300)
  participants    Json     @default("[]")
  content         String   @db.Text
  resolvedItems   Json     @default("[]") @map("resolved_items")
  unresolvedItems Json     @default("[]") @map("unresolved_items")
  attachments     Json?
  createdById     String   @map("created_by_id")
  tenantId        String?  @map("tenant_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User     @relation("JournalCreator", fields: [createdById], references: [id])
  tenant          Tenant?  @relation("TenantProjectJournals", fields: [tenantId], references: [id])

