// ─── HR v4 — Danh mục chức danh & vị trí biên chế ───────────────────────────

model JobTitle {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  band        String?
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  positions   Position[]
  orgUnits    OrgUnit[]

  @@map("job_titles")
}

model Position {
  id          String            @id @default(uuid())
  code        String            @unique
  jobTitleId  String            @map("job_title_id")
  orgUnitId   String            @map("org_unit_id")
  headcount   Int               @default(1)
  isHead      Boolean           @default(false) @map("is_head")
  description String?
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  jobTitle    JobTitle          @relation(fields: [jobTitleId], references: [id])
  orgUnit     OrgUnit           @relation(fields: [orgUnitId], references: [id])
  employees   Employee[]
  histories   PositionHistory[]
  salaryBands SalaryBand[]

  @@map("positions")
}

model PositionHistory {
  id         String    @id @default(uuid())
  positionId String    @map("position_id")
  employeeId String    @map("employee_id")
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")
  position   Position  @relation(fields: [positionId], references: [id])
  employee   Employee  @relation(fields: [employeeId], references: [id])

  @@map("position_histories")
}

// ─── HR v4 — Quyết định nhân sự ──────────────────────────────────────────────

model HrDecision {
  id                String           @id @default(uuid())
  decisionNumber    String?          @unique @map("decision_number") @db.VarChar(100)
  type              HrDecisionType
  employeeId        String           @map("employee_id")
  effectiveDate     DateTime         @map("effective_date") @db.Date
  signedDate        DateTime?        @map("signed_date") @db.Date
  content           String?          @db.Text
  signedBy          String?          @map("signed_by") @db.VarChar(200)
  notes             String?          @db.Text
  status            HrDecisionStatus @default(DRAFT)
  fromOrgUnitId     String?          @map("from_org_unit_id")
  toOrgUnitId       String?          @map("to_org_unit_id")
  fromPositionId    String?          @map("from_position_id")
  toPositionId      String?          @map("to_position_id")
  fromSalary        Decimal?         @map("from_salary") @db.Decimal(18, 2)
  toSalary          Decimal?         @map("to_salary") @db.Decimal(18, 2)
  processInstanceId String?          @map("process_instance_id")
  createdById       String?          @map("created_by_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  employee          Employee         @relation(fields: [employeeId], references: [id])
  workHistories     WorkHistory[]
  salaryRecords     SalaryRecord[]

  @@index([employeeId])
  @@index([effectiveDate])
  @@map("hr_decisions")
}

model WorkHistory {
  id           String               @id @default(uuid())
  employeeId   String               @map("employee_id")
  eventType    WorkHistoryEventType @map("event_type")
  eventDate    DateTime             @map("event_date") @db.Date
  title        String               @db.VarChar(300)
  description  String?              @db.Text
  hrDecisionId String?              @map("hr_decision_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  employee     Employee             @relation(fields: [employeeId], references: [id])
  hrDecision   HrDecision?          @relation(fields: [hrDecisionId], references: [id])

  @@index([employeeId])
  @@map("work_history")
}

model SalaryRecord {
  id            String      @id @default(uuid())
  employeeId    String      @map("employee_id")
  basicSalary   Decimal     @map("basic_salary") @db.Decimal(18, 2)
  effectiveDate DateTime    @map("effective_date") @db.Date
  source        String?     @db.VarChar(100)
  note          String?     @db.Text
  createdBy     String?     @map("created_by")
  hrDecisionId  String?     @map("hr_decision_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  employee      Employee    @relation(fields: [employeeId], references: [id])
  hrDecision    HrDecision? @relation(fields: [hrDecisionId], references: [id])

  @@index([employeeId])
  @@map("salary_records")
}

// ─── HR v4 — Enums ────────────────────────────────────────────────────────────

enum EmployeeStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  TERMINATED

  @@map("employee_status")
}

enum HrDecisionType {
  HIRE
  PROBATION_END
  TRANSFER
  POSITION_CHANGE
  SALARY_CHANGE
  COMMENDATION
  DISCIPLINE
  TERMINATION
  PROMOTION
  SECONDMENT

  @@map("hr_decision_type")
}

enum HrDecisionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED

  @@map("hr_decision_status")
}

enum WorkHistoryEventType {
  HR_DECISION
  PROBATION_ENDED

  @@map("work_history_event_type")
}

// ─── Employee ID Type ─────────────────────────────────────────────────────────

enum IdType {
  CCCD
  CMND
  PASSPORT
  OTHER

  @@map("id_type")
}

// ─── Leave Policy ──────────────────────────────────────────────────────────────

enum CarryOverExpiryAction {
  CLEAR
  CARRY_OVER
  PAY_OUT

  @@map("carry_over_expiry_action")
}

enum LeaveAccrualMode {
  ANNUAL_UPFRONT
  MONTHLY_ACCRUAL

  @@map("leave_accrual_mode")
}

model LeavePolicy {
  id                    String                @id @default(uuid())
  name                  String
  baseAnnualDays        Int                   @map("base_annual_days")
  seniorityBonus        Json                  @default("[]") @map("seniority_bonus")
  maxCarryOver          Int                   @default(0) @map("max_carry_over")
  carryOverExpiry       String?               @map("carry_over_expiry")
  carryOverExpiryAction CarryOverExpiryAction @default(CLEAR) @map("carry_over_expiry_action")
  probationPolicy       Json?                 @map("probation_policy")
  accrualMode           LeaveAccrualMode      @default(ANNUAL_UPFRONT) @map("accrual_mode")
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  employees             Employee[]

  @@map("leave_policies")
}

// ─── Holiday Calendar ─────────────────────────────────────────────────────────

enum HolidayType {
  NATIONAL_HOLIDAY
  COMPANY_HOLIDAY
  REGIONAL_HOLIDAY
  COMPENSATORY_DAY

  @@map("holiday_type")
}

model HolidayCalendar {
  id        String      @id @default(uuid())
  date      DateTime    @unique @db.Date
  name      String
  type      HolidayType @default(NATIONAL_HOLIDAY)
  year      Int
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([year])
  @@map("holiday_calendars")
}

// ─── Insurance ────────────────────────────────────────────────────────────────

enum InsuranceEnrollmentStatus {
  ACTIVE
  SUSPENDED
  TERMINATED

  @@map("insurance_enrollment_status")
}

enum InsuranceEventType {
  ENROLL
  SALARY_CHANGE
  SUSPEND
  RESUME
  TERMINATE

  @@map("insurance_event_type")
}

model InsuranceEnrollment {
  id                  String                    @id @default(uuid())
  employeeId          String                    @map("employee_id")
  bhxhBookNumber      String?                   @map("bhxh_book_number")
  insuranceSalary     Decimal                   @map("insurance_salary") @db.Decimal(15, 2)
  startDate           DateTime                  @map("start_date") @db.Date
  endDate             DateTime?                 @map("end_date") @db.Date
  status              InsuranceEnrollmentStatus @default(ACTIVE)
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  employee            Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  socialInsuranceBook SocialInsuranceBook?
  events              InsuranceEvent[]

  @@index([employeeId])
  @@map("insurance_enrollments")
}

model SocialInsuranceBook {
  id                 String               @id @default(uuid())
  employeeId         String               @unique @map("employee_id")
  enrollmentId       String?              @unique @map("enrollment_id")
  bookNumber         String               @unique @map("book_number")
  issueDate          DateTime?            @map("issue_date") @db.Date
  issueAuthority     String?              @map("issue_authority")
  receivedByEmployee Boolean              @default(false) @map("received_by_employee")
  receivedDate       DateTime?            @map("received_date") @db.Date
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  employee           Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  enrollment         InsuranceEnrollment? @relation(fields: [enrollmentId], references: [id])

  @@map("social_insurance_books")
}

model InsuranceEvent {
  id              String              @id @default(uuid())
  enrollmentId    String              @map("enrollment_id")
  eventType       InsuranceEventType  @map("event_type")
  insuranceSalary Decimal?            @map("insurance_salary") @db.Decimal(15, 2)
  effectiveDate   DateTime            @map("effective_date") @db.Date
  reason          String?
  hrDecisionId    String?             @map("hr_decision_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  enrollment      InsuranceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@map("insurance_events")
}

// ─── HR Attendance ────────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  LEAVE
  OT
  BUSINESS_TRIP
  ONSITE
  WFH

  @@map("attendance_status")
}

enum MonthlyAttendanceStatus {
  OPEN
  LOCKED
  APPROVED

  @@map("monthly_attendance_status")
}

model AttendanceRecord {
  id                  String                  @id @default(uuid())
  employeeId          String                  @map("employee_id")
  monthlyAttendanceId String?                 @map("monthly_attendance_id")
  shiftId             String?                 @map("shift_id")
  date                DateTime                @db.Date
  checkIn             DateTime?               @map("check_in")
  checkOut            DateTime?               @map("check_out")
  plannedStart        String?                 @map("planned_start")
  plannedEnd          String?                 @map("planned_end")
  totalHours          Decimal?                @map("total_hours") @db.Decimal(5, 2)
  status              AttendanceStatus        @default(PRESENT)
  lateMinutes         Int                     @default(0) @map("late_minutes")
  earlyLeaveMinutes   Int                     @default(0) @map("early_leave_minutes")
  overtimeMinutes     Int                     @default(0) @map("overtime_minutes")
  leaveType           String?                 @map("leave_type")
  note                String?
  isManual            Boolean                 @default(false) @map("is_manual")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  employee            Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  monthlyAttendance   MonthlyAttendance?      @relation(fields: [monthlyAttendanceId], references: [id])
  explanations        AttendanceExplanation[]

  @@unique([employeeId, date])
  @@index([employeeId])
  @@map("attendance_records")
}

model MonthlyAttendance {
  id              String                  @id @default(uuid())
  employeeId      String                  @map("employee_id")
  year            Int
  month           Int
  workDays        Decimal                 @default(0) @map("work_days") @db.Decimal(5, 1)
  paidLeaveDays   Decimal                 @default(0) @map("paid_leave_days") @db.Decimal(5, 1)
  unpaidLeaveDays Decimal                 @default(0) @map("unpaid_leave_days") @db.Decimal(5, 1)
  otHours         Decimal                 @default(0) @map("ot_hours") @db.Decimal(6, 2)
  absentDays      Decimal                 @default(0) @map("absent_days") @db.Decimal(5, 1)
  holidayDays     Decimal                 @default(0) @map("holiday_days") @db.Decimal(5, 1)
  status          MonthlyAttendanceStatus @default(OPEN)
  lockedAt        DateTime?               @map("locked_at")
  lockedById      String?                 @map("locked_by_id")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  employee        Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  records         AttendanceRecord[]

  @@unique([employeeId, year, month])
  @@index([employeeId])
  @@map("monthly_attendances")
}

// ─── Attendance Explanation ───────────────────────────────────────────────────

enum ExplanationType {
  MISSING_CHECKIN
  MISSING_CHECKOUT
  LATE_ARRIVAL
  EARLY_DEPARTURE
  BUSINESS_TRIP
  ONSITE
  WFH

  @@map("explanation_type")
}

enum ExplanationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("explanation_status")
}

model AttendanceExplanation {
  id                 String            @id @default(uuid())
  employeeId         String            @map("employee_id")
  date               DateTime          @db.Date
  attendanceRecordId String?           @map("attendance_record_id")
  type               ExplanationType
  reason             String            @db.Text
  attachments        Json?
  requestedCheckIn   DateTime?         @map("requested_check_in")
  requestedCheckOut  DateTime?         @map("requested_check_out")
  status             ExplanationStatus @default(PENDING)
  processInstanceId  String?           @map("process_instance_id")
  reviewedById       String?           @map("reviewed_by_id")
  reviewedAt         DateTime?         @map("reviewed_at")
  rejectReason       String?           @map("reject_reason")
  tenantId           String?           @map("tenant_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  employee           Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceRecord   AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  tenant             Tenant?           @relation("TenantAttendanceExplanations", fields: [tenantId], references: [id])

  @@index([employeeId, date])
  @@index([tenantId])
  @@map("attendance_explanations")
}

// ─── Work Shifts ──────────────────────────────────────────────────────────────

enum ShiftType {
  HANH_CHINH
  CA_SANG
  CA_CHIEU
  CA_DEM
  LINH_HOAT

  @@map("shift_type")
}

model WorkShift {
  id             String              @id @default(uuid())
  name           String
  code           String              @unique
  type           ShiftType           @default(HANH_CHINH)
  startTime      String              @map("start_time")
  endTime        String              @map("end_time")
  breakMinutes   Int                 @default(60) @map("break_minutes")
  isActive       Boolean             @default(true) @map("is_active")
  description    String?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  assignments    ShiftAssignment[]
  schedulePhases WorkSchedulePhase[]

  @@map("work_shifts")
}

model ShiftAssignment {
  id            String    @id @default(uuid())
  employeeId    String    @map("employee_id")
  shiftId       String    @map("shift_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift         WorkShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("shift_assignments")
}

model WorkSchedule {
  id          String                   @id @default(uuid())
  name        String
  description String?
  repeatType  String?                  @map("repeat_type")
  isActive    Boolean                  @default(true) @map("is_active")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  phases      WorkSchedulePhase[]
  enrollments WorkScheduleEnrollment[]

  @@map("work_schedules")
}

model WorkSchedulePhase {
  id             String       @id @default(uuid())
  workScheduleId String       @map("work_schedule_id")
  shiftId        String?      @map("shift_id")
  phaseOrder     Int          @map("phase_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  workSchedule   WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)
  shift          WorkShift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([workScheduleId])
  @@map("work_schedule_phases")
}

model WorkScheduleEnrollment {
  id            String       @id @default(uuid())
  employeeId    String?      @map("employee_id")
  orgUnitId     String?      @map("org_unit_id")
  scheduleId    String       @map("schedule_id")
  effectiveFrom DateTime     @map("effective_from") @db.Date
  effectiveTo   DateTime?    @map("effective_to") @db.Date
  note          String?
  createdAt     DateTime     @default(now()) @map("created_at")
  employee      Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule      WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("work_schedule_enrollments")
}
