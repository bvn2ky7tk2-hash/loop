  @@index([tenantId])
  @@map("project_journals")
}

// ─── Salary Band & Review Suggestion ─────────────────────────────────────────

enum SalaryReviewStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

model SalaryBand {
  id            String                   @id @default(uuid())
  positionId    String                   @map("position_id")
  minSalary     Decimal                  @map("min_salary") @db.Decimal(18, 2)
  midSalary     Decimal                  @map("mid_salary") @db.Decimal(18, 2)
  maxSalary     Decimal                  @map("max_salary") @db.Decimal(18, 2)
  currency      String                   @default("VND")
  effectiveFrom DateTime                 @map("effective_from") @db.Date
  createdAt     DateTime                 @default(now()) @map("created_at")
  position      Position                 @relation(fields: [positionId], references: [id])
  suggestions   SalaryReviewSuggestion[]

  @@index([positionId])
  @@map("salary_bands")
}

model SalaryReviewSuggestion {
  id              String             @id @default(uuid())
  reviewId        String             @map("review_id")
  employeeId      String             @map("employee_id")
  salaryBandId    String?            @map("salary_band_id")
  currentSalary   Decimal            @map("current_salary") @db.Decimal(18, 2)
  suggestedSalary Decimal            @map("suggested_salary") @db.Decimal(18, 2)
  increasePercent Decimal            @map("increase_percent") @db.Decimal(5, 2)
  reason          String?
  status          SalaryReviewStatus @default(PENDING)
  approvedById    String?            @map("approved_by_id")
  appliedAt       DateTime?          @map("applied_at")
