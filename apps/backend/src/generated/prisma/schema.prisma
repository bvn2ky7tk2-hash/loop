  updatedAt       DateTime           @updatedAt @map("updated_at")
  employee        Employee           @relation("EmployeeSalaryReviews", fields: [employeeId], references: [id])
  salaryBand      SalaryBand?        @relation(fields: [salaryBandId], references: [id])
  approvedBy      User?              @relation("SalaryReviewApprover", fields: [approvedById], references: [id])

  @@index([employeeId])
  @@index([reviewId])
  @@map("salary_review_suggestions")
}

model Tenant {
  id                     String                   @id @default(uuid())
  name                   String
  slug                   String                   @unique
