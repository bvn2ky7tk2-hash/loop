// ─── Vehicle Booking ──────────────────────────────────────────────────────────

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED

  @@map("vehicle_status")
}

enum VehicleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("vehicle_request_status")
}

model Vehicle {
  id          String           @id @default(uuid())
  name        String           @db.VarChar(200)
  plateNumber String           @unique @map("plate_number") @db.VarChar(20)
  type        String           @db.VarChar(50)
  seats       Int              @default(4)
  status      VehicleStatus    @default(AVAILABLE)
  driverId    String?          @map("driver_id")
  imageUrl    String?          @map("image_url") @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  requests    VehicleRequest[]
  driver      User?            @relation("VehicleDriver", fields: [driverId], references: [id])

  @@map("vehicles")
}

model VehicleRequest {
  id              String               @id @default(uuid())
  vehicleId       String               @map("vehicle_id")
  requestedById   String               @map("requested_by_id")
  approvedById    String?              @map("approved_by_id")
  purpose         String               @db.VarChar(500)
  destination     String               @db.VarChar(300)
  startTime       DateTime             @map("start_time")
  endTime         DateTime             @map("end_time")
  passengerCount  Int                  @default(1) @map("passenger_count")
  status          VehicleRequestStatus @default(PENDING)
  rejectionReason String?              @map("rejection_reason") @db.Text
