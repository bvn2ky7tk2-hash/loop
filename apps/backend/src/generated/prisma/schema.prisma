  employees              Employee[]               @relation("TenantEmployees")
  projects               Project[]                @relation("TenantProjects")
  tasks                  Task[]                   @relation("TenantTasks")
  bugs                   Bug[]                    @relation("TenantBugs")
  deals                  Deal[]                   @relation("TenantDeals")
  customers              Customer[]               @relation("TenantCustomers")
  contacts               Contact[]                @relation("TenantContacts")
  leads                  Lead[]                   @relation("TenantLeads")
  invoices               Invoice[]                @relation("TenantInvoices")
  contracts              Contract[]               @relation("TenantContracts")
  assets                 Asset[]                  @relation("TenantAssets")
  kbArticles             KbArticle[]              @relation("TenantKbArticles")
  okrObjectives          OkrObjective[]           @relation("TenantOkrObjectives")
  leaveRequests          LeaveRequest[]           @relation("TenantLeaveRequests")
  leaveBalances          LeaveBalance[]           @relation("TenantLeaveBalances")
  timeEntries            TimeEntry[]              @relation("TenantTimeEntries")
  allocations            Allocation[]             @relation("TenantAllocations")
  processInstances       ProcessInstance[]        @relation("TenantProcessInstances")
  processDefinitions     ProcessDefinition[]      @relation("TenantProcessDefinitions")
  payrollPeriods         PayrollPeriod[]          @relation("TenantPayrollPeriods")
  payrollRecords         PayrollRecord[]          @relation("TenantPayrollRecords")
  crmActivities          CrmActivity[]            @relation("TenantCrmActivities")
  clientContracts        ClientContract[]         @relation("TenantClientContracts")
  jobOpenings            JobOpening[]             @relation("TenantJobOpenings")
  candidates             Candidate[]              @relation("TenantCandidates")
  interviews             Interview[]              @relation("TenantInterviews")
  customerPortals        CustomerPortal[]         @relation("TenantCustomerPortals")
  vendors                Vendor[]                 @relation("TenantVendors")
  purchaseOrders         PurchaseOrder[]          @relation("TenantPurchaseOrders")
  comments               Comment[]                @relation("TenantComments")
  invoiceMappings        InvoiceAccountMapping[]  @relation("TenantInvoiceMappings")
  delegationRules        DelegationRule[]         @relation("TenantDelegations")
  attendanceExplanations AttendanceExplanation[]  @relation("TenantAttendanceExplanations")
  projectJournals        ProjectJournal[]         @relation("TenantProjectJournals")
  leadFollowUps          LeadFollowUpSchedule[]   @relation("TenantLeadFollowUps")
  customerSurveys        CustomerSurveySchedule[] @relation("TenantCustomerSurveys")

