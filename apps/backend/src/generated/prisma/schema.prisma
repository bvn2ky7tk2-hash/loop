// ─── Phase 2: HR — Contracts ──────────────────────────────────────────────────

model Contract {
  id                 String              @id @default(uuid())
  employeeId         String              @map("employee_id")
  type               ContractType        @default(INDEFINITE)
  status             ContractStatus      @default(ACTIVE)
  startDate          DateTime            @map("start_date") @db.Date
  endDate            DateTime?           @map("end_date") @db.Date
  salaryMonthly      Decimal             @map("salary_monthly") @db.Decimal(15, 2)
  currency           BudgetCurrency      @default(VND)
  note               String?
  signedAt           DateTime?           @map("signed_at") @db.Date
  signedById         String?             @map("signed_by_id")
  // Gia hạn HĐ
  renewalCount       Int                 @default(0) @map("renewal_count")
  previousContractId String?             @map("previous_contract_id")
  autoExpireHandled  Boolean             @default(false) @map("auto_expire_handled")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  signedBy           Employee?           @relation("ContractSigner", fields: [signedById], references: [id])
  previousContract   Contract?           @relation("ContractRenewal", fields: [previousContractId], references: [id])
  renewals           Contract[]          @relation("ContractRenewal")
  tenantId           String?             @map("tenant_id")
  tenant             Tenant?             @relation("TenantContracts", fields: [tenantId], references: [id])
  deletedAt          DateTime?           @map("deleted_at")
  allowances         ContractAllowance[]

  @@index([employeeId])
  @@index([status])
  @@index([tenantId])
  @@index([deletedAt])
  @@index([previousContractId])
  @@map("contracts")
}

model ContractAllowance {
  id              String        @id @default(uuid())
  contractId      String        @map("contract_id")
  allowanceTypeId String        @map("allowance_type_id")
  amount          Decimal       @db.Decimal(12, 2)
  note            String?
  contract        Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  allowanceType   AllowanceType @relation(fields: [allowanceTypeId], references: [id])

  @@unique([contractId, allowanceTypeId])
  @@index([contractId])
  @@map("contract_allowances")
}

enum ContractType {
  // Loại HĐ theo Bộ luật Lao động 2019 (Điều 20)
  PROBATION // Thử việc (≤60 ngày phổ thông, ≤180 ngày quản lý/chuyên gia)
  FIXED_12 // Xác định thời hạn 12 tháng
  FIXED_24 // Xác định thời hạn 24 tháng
  FIXED_36 // Xác định thời hạn 36 tháng
  INDEFINITE // Không xác định thời hạn (vô thời hạn)
  PART_TIME // Bán thời gian
  SEASONAL // Thời vụ / Công việc cụ thể (dưới 12 tháng)

  @@map("contract_type")
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED

  @@map("contract_status")
}

// ─── Phase 2: HR — Leave Management ──────────────────────────────────────────

model LeaveType {
  id                   String         @id @default(uuid())
  name                 String         @unique
  maxDaysPerYear       Int            @map("max_days_per_year")
  isPaid               Boolean        @default(true) @map("is_paid")
  color                String         @default("#2563EB")
  isActive             Boolean        @default(true) @map("is_active")
  processDefinitionKey String?        @map("process_definition_key")
  annualDays           Int            @default(0) @map("annual_days")
  maxCarryOver         Int            @default(0) @map("max_carry_over")
  createdAt            DateTime       @default(now()) @map("created_at")
  requests             LeaveRequest[]
  balances             LeaveBalance[]

  @@map("leave_types")
}

model LeaveRequest {
  id                String           @id @default(uuid())
  employeeId        String           @map("employee_id")
  leaveTypeId       String           @map("leave_type_id")
  startDate         DateTime         @map("start_date") @db.Date
  endDate           DateTime         @map("end_date") @db.Date
  days              Decimal          @db.Decimal(5, 1)
  reason            String?
  status            LeaveStatus      @default(PENDING)
  approvedById      String?          @map("approved_by_id")
  approvedAt        DateTime?        @map("approved_at")
  rejectedReason    String?          @map("rejected_reason")
  processInstanceId String?          @map("process_instance_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType         LeaveType        @relation(fields: [leaveTypeId], references: [id])
  approvedBy        User?            @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  processInstance   ProcessInstance? @relation(fields: [processInstanceId], references: [id])

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("TenantLeaveRequests", fields: [tenantId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([processInstanceId])
  @@index([tenantId])
  @@map("leave_requests")
}

model LeaveBalance {
  id              String    @id @default(uuid())
  employeeId      String    @map("employee_id")
  leaveTypeId     String    @map("leave_type_id")
  year            Int
  totalDays       Decimal   @map("total_days") @db.Decimal(5, 1)
  usedDays        Decimal   @default(0) @map("used_days") @db.Decimal(5, 1)
  entitlementDays Decimal?  @map("entitlement_days") @db.Decimal(5, 1)
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("TenantLeaveBalances", fields: [tenantId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([tenantId])
  @@map("leave_balances")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("leave_status")
}

enum OtStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("ot_status")
}

enum OtDayType {
  WEEKDAY
  WEEKEND
  HOLIDAY
}

model OvertimeRequest {
  id                String           @id @default(uuid())
  employeeId        String           @map("employee_id")
  date              DateTime         @db.Date
  fromTime          String?          @map("from_time")
  toTime            String?          @map("to_time")
  hours             Decimal          @db.Decimal(4, 1)
  dayType           OtDayType        @default(WEEKDAY) @map("day_type")
  reason            String?
  status            OtStatus         @default(PENDING)
  approvedById      String?          @map("approved_by_id")
  approvedAt        DateTime?        @map("approved_at")
  rejectedReason    String?          @map("rejected_reason")
  processInstanceId String?          @map("process_instance_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy        User?            @relation("OtApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  processInstance   ProcessInstance? @relation(fields: [processInstanceId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([status])
  @@map("overtime_requests")
}

// ─── Phase 2: HR — Payroll ────────────────────────────────────────────────────

model PayrollPeriod {
  id                    String            @id @default(uuid())
  name                  String
  startDate             DateTime          @map("start_date") @db.Date
  endDate               DateTime          @map("end_date") @db.Date
  status                PayrollStatus     @default(DRAFT)
  type                  PayrollPeriodType @default(REGULAR) @map("type")
  adjustmentForPeriodId String?           @map("adjustment_for_period_id")
  processedById         String?           @map("processed_by_id")
  processedAt           DateTime?         @map("processed_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  records               PayrollRecord[]
  processedBy           User?             @relation("PayrollProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  adjustmentFor         PayrollPeriod?    @relation("AdjustmentPeriod", fields: [adjustmentForPeriodId], references: [id])
  adjustments           PayrollPeriod[]   @relation("AdjustmentPeriod")
  tenantId              String?           @map("tenant_id")
  tenant                Tenant?           @relation("TenantPayrollPeriods", fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("payroll_periods")
}

model PayrollRecord {
  id                   String              @id @default(uuid())
  periodId             String              @map("period_id")
  employeeId           String              @map("employee_id")
  workDays             Decimal             @map("work_days") @db.Decimal(5, 1)
  leaveDays            Decimal             @default(0) @map("leave_days") @db.Decimal(5, 1)
  paidLeaveDays        Decimal             @default(0) @map("paid_leave_days") @db.Decimal(5, 1)
  unpaidLeaveDays      Decimal             @default(0) @map("unpaid_leave_days") @db.Decimal(5, 1)
  overtimeHours        Decimal             @default(0) @map("overtime_hours") @db.Decimal(7, 2)
  overtimePayBreakdown Json?               @map("overtime_pay_breakdown")
  baseSalary           Decimal             @default(0) @map("base_salary") @db.Decimal(15, 2)
  grossSalary          Decimal             @default(0) @map("gross_salary") @db.Decimal(15, 2)
  overtimePay          Decimal             @default(0) @map("overtime_pay") @db.Decimal(15, 2)
  allowances           Decimal             @default(0) @db.Decimal(15, 2)
  deductions           Decimal             @default(0) @db.Decimal(15, 2)
  bonus                Decimal             @default(0) @db.Decimal(15, 2)
  bhxhEmployee         Decimal             @default(0) @map("bhxh_employee") @db.Decimal(15, 2)
  bhytEmployee         Decimal             @default(0) @map("bhyt_employee") @db.Decimal(15, 2)
  bhtnEmployee         Decimal             @default(0) @map("bhtn_employee") @db.Decimal(15, 2)
  bhxhEmployer         Decimal             @default(0) @map("bhxh_employer") @db.Decimal(15, 2)
  bhytEmployer         Decimal             @default(0) @map("bhyt_employer") @db.Decimal(15, 2)
  bhtnEmployer         Decimal             @default(0) @map("bhtn_employer") @db.Decimal(15, 2)
  tnldEmployer         Decimal             @default(0) @map("tnld_employer") @db.Decimal(15, 2)
  taxableIncome        Decimal             @default(0) @map("taxable_income") @db.Decimal(15, 2)
  selfDeduction        Decimal             @default(0) @map("self_deduction") @db.Decimal(15, 2)
  dependentDeduction   Decimal             @default(0) @map("dependent_deduction") @db.Decimal(15, 2)
  dependentCount       Int                 @default(0) @map("dependent_count")
  pitAmount            Decimal             @default(0) @map("pit_amount") @db.Decimal(15, 2)
  totalLaborCost       Decimal             @default(0) @map("total_labor_cost") @db.Decimal(15, 2)
  netSalary            Decimal             @default(0) @map("net_salary") @db.Decimal(15, 2)
  payslipPath          String?             @map("payslip_path")
  configSnapshot       Json?               @map("config_snapshot")
  overrideNote         String?             @map("override_note")
  note                 String?
  period               PayrollPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee             Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeAllowances   EmployeeAllowance[]
  employeeBonuses      EmployeeBonus[]
  tenantId             String?             @map("tenant_id")
  tenant               Tenant?             @relation("TenantPayrollRecords", fields: [tenantId], references: [id])

  @@unique([periodId, employeeId])
  @@index([employeeId, periodId])
  @@index([periodId])
  @@index([tenantId])
  @@map("payroll_records")
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  REVIEWED
  APPROVED
  PAID

  @@map("payroll_status")
}

// ─── Phase 2: PM — Expense Management ────────────────────────────────────────

model Expense {
  id                String           @id @default(uuid())
  projectId         String?          @map("project_id")
  submittedById     String           @map("submitted_by_id")
  employeeId        String?          @map("employee_id")
  title             String
  category          ExpenseCategory  @default(OTHER)
  totalAmount       Decimal          @map("total_amount") @db.Decimal(15, 2)
  currency          BudgetCurrency   @default(VND)
  status            ExpenseStatus    @default(PENDING)
  approvedById      String?          @map("approved_by_id")
  approvedAt        DateTime?        @map("approved_at")
  rejectedReason    String?          @map("rejected_reason")
  processInstanceId String?          @map("process_instance_id")
  note              String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  items             ExpenseItem[]
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  submittedBy       User             @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  approvedBy        User?            @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  processInstance   ProcessInstance? @relation(fields: [processInstanceId], references: [id])
  employee          Employee?        @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([submittedById])
  @@index([status])
  @@index([processInstanceId])
  @@map("expenses")
}

model ExpenseItem {
  id          String  @id @default(uuid())
  expenseId   String  @map("expense_id")
  description String
  amount      Decimal @db.Decimal(15, 2)
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@map("expense_items")
}

enum ExpenseCategory {
  TRAVEL
  MEALS
  EQUIPMENT
  SOFTWARE
  TRAINING
  OTHER

  @@map("expense_category")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID

  @@map("expense_status")
}

// ─── Phase 3A: CRM ────────────────────────────────────────────────────────────

model Customer {
  id              String                   @id @default(uuid())
  code            String
  name            String
  industry        String?
  website         String?
  taxCode         String?                  @map("tax_code")
  contacts        Contact[]
  deals           Deal[]
  invoices        Invoice[]
  clientContracts ClientContract[]
  activities      CrmActivity[]
  portals         CustomerPortal[]
  projects        Project[]
  surveySchedules CustomerSurveySchedule[]
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  tenantId        String?                  @map("tenant_id")
  tenant          Tenant?                  @relation("TenantCustomers", fields: [tenantId], references: [id])
  deletedAt       DateTime?                @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("customers")
}

model Contact {
  id         String    @id @default(uuid())
  name       String
  email      String?
  phone      String?
  title      String?
  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leads      Lead[]
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  tenantId   String?   @map("tenant_id")
  tenant     Tenant?   @relation("TenantContacts", fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([tenantId])
  @@map("contacts")
}

model Lead {
  id              String     @id @default(uuid())
  title           String     @db.VarChar(200)
  contactId       String?    @map("contact_id")
  contact         Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source          LeadSource
  status          LeadStatus @default(NEW)
  estimatedValue  Decimal?   @map("estimated_value") @db.Decimal(18, 2)
  currency        String     @default("VND")
  assigneeId      String     @map("assignee_id")
  notes           String?    @db.Text
  convertedDealId String?    @map("converted_deal_id")
  convertedAt     DateTime?  @map("converted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenantId          String?                @map("tenant_id")
  tenant            Tenant?                @relation("TenantLeads", fields: [tenantId], references: [id])
  followUpSchedules LeadFollowUpSchedule[]

  @@index([assigneeId])
  @@index([status])
  @@index([tenantId])
  @@map("leads")
}

model Deal {
  id                String                 @id @default(uuid())
  code              String
  title             String                 @db.VarChar(200)
  customerId        String                 @map("customer_id")
  customer          Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  stage             DealStage              @default(QUALIFICATION)
  value             Decimal?               @db.Decimal(18, 2)
  currency          String                 @default("VND")
  probability       Int?
  expectedCloseDate DateTime?              @map("expected_close_date")
  assigneeId        String                 @map("assignee_id")
  wonAt             DateTime?              @map("won_at")
  lostAt            DateTime?              @map("lost_at")
  lostReason        String?                @map("lost_reason")
  projectId         String?                @map("project_id")
  processInstanceId String?                @map("process_instance_id")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  tenantId          String?                @map("tenant_id")
  tenant            Tenant?                @relation("TenantDeals", fields: [tenantId], references: [id])
  deletedAt         DateTime?              @map("deleted_at")
  invoices          Invoice[]              @relation("DealInvoices")
  followUpSchedules LeadFollowUpSchedule[]

  @@unique([tenantId, code])
  @@index([customerId])
  @@index([stage])
  @@index([assigneeId])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("deals")
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL
  EVENT
  COLD_OUTREACH
  OTHER

  @@map("lead_source")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST

  @@map("lead_status")
}

enum DealStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST

  @@map("deal_stage")
}

// ─── CRM Activities ──────────────────────────────────────────────────────────

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  DEMO
  SITE_VISIT
  SURVEY
  TASK

  @@map("activity_type")
}

model CrmActivity {
  id              String       @id @default(uuid())
  type            ActivityType
  subject         String       @db.VarChar(200)
  content         String?      @db.Text
  customerId      String?      @map("customer_id")
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealId          String?      @map("deal_id")
  contactId       String?      @map("contact_id")
  leadId          String?      @map("lead_id")
  projectId       String?      @map("project_id")
  project         Project?     @relation("ProjectCrmActivities", fields: [projectId], references: [id], onDelete: SetNull)
  scheduledAt     DateTime?    @map("scheduled_at")
  completedAt     DateTime?    @map("completed_at")
  duration        Int?
  outcome         String?      @db.Text
  nextAction      String?      @map("next_action") @db.VarChar(300)
  nextActionDueAt DateTime?    @map("next_action_due_at")
  createdById     String       @map("created_by_id")
  createdBy       User         @relation("CrmActivityCreator", fields: [createdById], references: [id])
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  tenantId        String?      @map("tenant_id")
  tenant          Tenant?      @relation("TenantCrmActivities", fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([dealId])
  @@index([leadId])
  @@index([contactId])
  @@index([projectId])
  @@index([createdById])
  @@index([tenantId])
  @@map("crm_activities")
}

// ─── Lead Follow-Up & Customer Survey Schedules ──────────────────────────────

enum FollowUpStatus {
  PENDING
  DONE
  SKIPPED

  @@map("follow_up_status")
}

enum SurveyFrequency {
  MONTHLY
  QUARTERLY
  YEARLY

  @@map("survey_frequency")
}

model LeadFollowUpSchedule {
  id            String         @id @default(uuid())
  leadId        String?        @map("lead_id")
  dealId        String?        @map("deal_id")
  scheduledDate DateTime       @map("scheduled_date") @db.Date
  type          ActivityType
  note          String?        @db.Text
  status        FollowUpStatus @default(PENDING)
  assigneeId    String         @map("assignee_id")
  tenantId      String?        @map("tenant_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal          Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  assignee      User           @relation(fields: [assigneeId], references: [id])
  tenant        Tenant?        @relation("TenantLeadFollowUps", fields: [tenantId], references: [id])

  @@index([leadId])
  @@index([dealId])
  @@index([assigneeId])
  @@index([tenantId])
  @@map("lead_follow_up_schedules")
}

model CustomerSurveySchedule {
  id              String          @id @default(uuid())
  customerId      String          @map("customer_id")
  frequency       SurveyFrequency @default(QUARTERLY)
  lastSentAt      DateTime?       @map("last_sent_at")
  nextDueAt       DateTime        @map("next_due_at") @db.Date
  templateContent String?         @map("template_content") @db.Text
  assigneeId      String          @map("assignee_id")
  isActive        Boolean         @default(true) @map("is_active")
  tenantId        String?         @map("tenant_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignee        User            @relation(fields: [assigneeId], references: [id])
  tenant          Tenant?         @relation("TenantCustomerSurveys", fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([assigneeId])
  @@index([tenantId])
  @@map("customer_survey_schedules")
}

// ─── Client Contracts ─────────────────────────────────────────────────────────

model ClientContract {
  id               String               @id @default(uuid())
  contractNo       String?              @map("contract_no")
  title            String               @db.VarChar(200)
  customerId       String               @map("customer_id")
  dealId           String?              @map("deal_id")
  type             ClientContractType   @default(SERVICE)
  value            Decimal?             @db.Decimal(18, 2)
  currency         String               @default("VND")
  startDate        DateTime             @map("start_date") @db.Date
  endDate          DateTime?            @map("end_date") @db.Date
  signedAt         DateTime?            @map("signed_at") @db.Date
  status           ClientContractStatus @default(DRAFT)
  paymentTermsDays Int?                 @map("payment_terms_days")
  notes            String?              @db.Text
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  customer         Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  milestones       ContractMilestone[]
  invoices         Invoice[]            @relation("ClientContractInvoices")
  tenantId         String?              @map("tenant_id")
  tenant           Tenant?              @relation("TenantClientContracts", fields: [tenantId], references: [id])

  @@unique([tenantId, contractNo])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
  @@map("client_contracts")
}

model ContractMilestone {
  id         String          @id @default(uuid())
  contractId String          @map("contract_id")
  name       String          @db.VarChar(200)
  dueDate    DateTime        @map("due_date") @db.Date
  amount     Decimal         @db.Decimal(18, 2)
  status     MilestoneStatus @default(PENDING)
  paidAt     DateTime?       @map("paid_at") @db.Date
  notes      String?
  invoiceId  String?         @unique @map("invoice_id")
  invoice    Invoice?        @relation("MilestoneInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now()) @map("created_at")
  contract   ClientContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_milestones")
}

enum ClientContractType {
  SERVICE
  PRODUCT
  SUPPORT
  SLA
  OTHER

  @@map("client_contract_type")
}

enum ClientContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("client_contract_status")
}

enum MilestoneStatus {
  PENDING
  COMPLETED
  INVOICED
  PAID

  @@map("milestone_status")
}

// ─── Phase 3A: Invoicing ──────────────────────────────────────────────────────

model Invoice {
  id                String             @id @default(uuid())
  code              String
  type              InvoiceType
  customerId        String?            @map("customer_id")
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId         String?            @map("project_id")
  dealId            String?            @map("deal_id")
  deal              Deal?              @relation("DealInvoices", fields: [dealId], references: [id], onDelete: SetNull)
  clientContractId  String?            @map("client_contract_id")
  clientContract    ClientContract?    @relation("ClientContractInvoices", fields: [clientContractId], references: [id], onDelete: SetNull)
  issueDate         DateTime           @map("issue_date") @db.Date
  dueDate           DateTime           @map("due_date") @db.Date
  status            InvoiceStatus      @default(DRAFT)
  subtotal          Decimal            @db.Decimal(18, 2)
  taxAmount         Decimal            @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount       Decimal            @map("total_amount") @db.Decimal(18, 2)
  currency          String             @default("VND")
  notes             String?            @db.Text
  paidAt            DateTime?          @map("paid_at")
  processInstanceId String?            @map("process_instance_id")
  createdById       String             @map("created_by_id")
  journalEntryId    String?            @unique @map("journal_entry_id")
  items             InvoiceItem[]
  milestone         ContractMilestone? @relation("MilestoneInvoice")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  tenantId          String?            @map("tenant_id")
  tenant            Tenant?            @relation("TenantInvoices", fields: [tenantId], references: [id])
  deletedAt         DateTime?          @map("deleted_at")

  @@unique([tenantId, code])
  @@index([status])
  @@index([customerId])
  @@index([projectId])
  @@index([dealId])
  @@index([clientContractId])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 2)
  amount      Decimal @db.Decimal(18, 2)
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

enum InvoiceType {
  SALES
  PURCHASE

  @@map("invoice_type")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED

  @@map("invoice_status")
}

// ─── Phase 3B: Recruitment ────────────────────────────────────────────────────

model JobOpening {
  id           String        @id @default(uuid())
  code         String
  title        String        @db.VarChar(200)
  orgUnitId    String        @map("org_unit_id")
  level        EmployeeLevel @default(JUNIOR)
  headcount    Int           @default(1)
  status       JobStatus     @default(OPEN)
  requirements String?       @db.Text
  salaryFrom   Decimal?      @map("salary_from") @db.Decimal(18, 2)
  salaryTo     Decimal?      @map("salary_to") @db.Decimal(18, 2)
  closedAt     DateTime?     @map("closed_at")
  candidates   Candidate[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  tenantId     String?       @map("tenant_id")
  tenant       Tenant?       @relation("TenantJobOpenings", fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([orgUnitId, status])
  @@index([tenantId])
  @@map("job_openings")
}

model Candidate {
  id                String         @id @default(uuid())
  name              String
  email             String?
  phone             String?
  cvStoragePath     String?        @map("cv_storage_path")
  jobOpeningId      String         @map("job_opening_id")
  jobOpening        JobOpening     @relation(fields: [jobOpeningId], references: [id], onDelete: Restrict)
  stage             CandidateStage @default(APPLIED)
  assigneeId        String?        @map("assignee_id")
  source            LeadSource?
  expectedSalary    Decimal?       @map("expected_salary") @db.Decimal(18, 2)
  interviews        Interview[]
  employeeId        String?        @unique @map("employee_id")
  processInstanceId String?        @map("process_instance_id")
  notes             String?        @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  tenantId          String?        @map("tenant_id")
  tenant            Tenant?        @relation("TenantCandidates", fields: [tenantId], references: [id])

  @@index([jobOpeningId, stage])
  @@index([assigneeId])
  @@index([tenantId])
  @@map("candidates")
}

model Interview {
  id           String          @id @default(uuid())
  candidateId  String          @map("candidate_id")
  candidate    Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type         InterviewType
  scheduledAt  DateTime        @map("scheduled_at")
  location     String?
  meetingUrl   String?         @map("meeting_url")
  interviewers String[]
  result       InterviewResult @default(PENDING)
  score        Int?
  notes        String?         @db.Text
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  tenantId     String?         @map("tenant_id")
  tenant       Tenant?         @relation("TenantInterviews", fields: [tenantId], references: [id])

  @@index([candidateId])
  @@index([tenantId])
  @@map("interviews")
}

enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED

  @@map("job_status")
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED

  @@map("candidate_stage")
}

enum InterviewType {
  PHONE
  TECHNICAL
  HR
  FINAL

  @@map("interview_type")
}

enum InterviewResult {
  PASS
  FAIL
  PENDING

  @@map("interview_result")
}

// ─── Epic 21: Asset Management ────────────────────────────────────────────────

model Asset {
  id                String             @id @default(uuid())
  code              String             @unique @db.VarChar(50)
  name              String             @db.VarChar(200)
  category          AssetCategory
  brand             String?            @db.VarChar(100)
  model             String?            @db.VarChar(100)
  serialNumber      String?            @map("serial_number") @db.VarChar(100)
  orgUnitId         String?            @map("org_unit_id")
  orgUnit           OrgUnit?           @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  status            AssetStatus        @default(AVAILABLE)
  purchaseDate      DateTime?          @map("purchase_date") @db.Date
  purchasePrice     Decimal?           @map("purchase_price") @db.Decimal(18, 2)
  depreciationYears Int?               @map("depreciation_years")
  notes             String?            @db.Text
  assignments       AssetAssignment[]
  maintenanceLogs   AssetMaintenance[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  tenantId          String?            @map("tenant_id")
  tenant            Tenant?            @relation("TenantAssets", fields: [tenantId], references: [id])

  @@index([orgUnitId, status], name: "idx_assets_org_status")
  @@index([tenantId])
  @@map("assets")
}

model AssetAssignment {
  id         String    @id @default(uuid())
  assetId    String    @map("asset_id")
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId String    @map("employee_id")
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedAt DateTime  @default(now()) @map("assigned_at")
  returnedAt DateTime? @map("returned_at")
  notes      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([assetId], name: "idx_asset_assignments_asset_id")
  @@index([employeeId], name: "idx_asset_assignments_employee_id")
  @@map("asset_assignments")
}

model AssetMaintenance {
  id          String   @id @default(uuid())
  assetId     String   @map("asset_id")
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type        String   @db.VarChar(50)
  performedAt DateTime @map("performed_at") @db.Date
  cost        Decimal? @db.Decimal(18, 2)
  performedBy String?  @map("performed_by") @db.VarChar(200)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([assetId])
  @@map("asset_maintenance")
}

enum AssetCategory {
  LAPTOP
  DESKTOP
  PHONE
  SERVER
  PERIPHERAL
  SOFTWARE
  FURNITURE
  VEHICLE
  OTHER

  @@map("asset_category")
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  RETIRED

  @@map("asset_status")
}

// ─── Accounting (double-entry) ────────────────────────────────────────────────

model ChartOfAccount {
  id             String                  @id @default(uuid())
  code           String                  @unique @db.VarChar(20)
  name           String                  @db.VarChar(200)
  type           AccountType
  parentCode     String?                 @map("parent_code") @db.VarChar(20)
  isActive       Boolean                 @default(true) @map("is_active")
  journalLines   JournalLine[]
  debitMappings  InvoiceAccountMapping[] @relation("MappingDebit")
  creditMappings InvoiceAccountMapping[] @relation("MappingCredit")
  vatMappings    InvoiceAccountMapping[] @relation("MappingVat")
  createdAt      DateTime                @default(now()) @map("created_at")

  @@index([type])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id          String        @id @default(uuid())
  date        DateTime      @db.Date
  description String        @db.VarChar(500)
  reference   String?       @db.VarChar(100)
  lines       JournalLine[]
  createdById String        @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([date])
  @@map("journal_entries")
}

model JournalLine {
  id          String         @id @default(uuid())
  entryId     String         @map("entry_id")
  entry       JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountCode String         @map("account_code") @db.VarChar(20)
  account     ChartOfAccount @relation(fields: [accountCode], references: [code])
  debit       Decimal        @default(0) @db.Decimal(18, 2)
  credit      Decimal        @default(0) @db.Decimal(18, 2)
  description String?        @db.VarChar(200)

  @@index([entryId])
  @@index([accountCode])
  @@map("journal_lines")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@map("account_type")
}

// ─── HR Extensions: Training + Performance Review ────────────────────────────

model TrainingProgram {
  id            String           @id @default(uuid())
  title         String           @db.VarChar(200)
  type          String           @db.VarChar(50)
  durationHours Int              @map("duration_hours")
  description   String?          @db.Text
  records       TrainingRecord[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@map("training_programs")
}

model TrainingRecord {
  id          String          @id @default(uuid())
  programId   String          @map("program_id")
  program     TrainingProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  employeeId  String          @map("employee_id")
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  startDate   DateTime        @map("start_date") @db.Date
  endDate     DateTime?       @map("end_date") @db.Date
  status      TrainingStatus  @default(SCHEDULED)
  score       Decimal?        @db.Decimal(5, 2)
  certificate String?         @db.VarChar(500)
  notes       String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([employeeId, status])
  @@index([programId])
  @@map("training_records")
}

model PerformanceReview {
  id                String             @id @default(uuid())
  employeeId        String             @map("employee_id")
  employee          Employee           @relation("ReviewSubject", fields: [employeeId], references: [id], onDelete: Restrict)
  reviewerId        String             @map("reviewer_id")
  reviewer          Employee           @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  period            String             @db.VarChar(20)
  score             Decimal?           @db.Decimal(3, 1)
  strengths         String?            @db.Text
  improvements      String?            @db.Text
  goals             String?            @db.Text
  status            ReviewStatus       @default(DRAFT)
  processInstanceId String?            @map("process_instance_id")
  submittedAt       DateTime?          @map("submitted_at")
  approvedAt        DateTime?          @map("approved_at")
