  processInstance   ProcessInstance? @relation(fields: [processInstanceId], references: [id])

  @@index([submittedById])
  @@index([status])
  @@index([processInstanceId])
  @@map("expenses")
}

model ExpenseItem {
  id          String  @id @default(uuid())
  expenseId   String  @map("expense_id")
  description String
  amount      Decimal @db.Decimal(15, 2)
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@map("expense_items")
}

enum ExpenseCategory {
  TRAVEL
  MEALS
  EQUIPMENT
  SOFTWARE
  TRAINING
  OTHER

  @@map("expense_category")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID

  @@map("expense_status")
}

// ─── Phase 3A: CRM ────────────────────────────────────────────────────────────

model Customer {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  industry        String?
  website         String?
  taxCode         String?          @map("tax_code")
  contacts        Contact[]
  deals           Deal[]
  invoices        Invoice[]
  clientContracts ClientContract[]
  activities      CrmActivity[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt      @map("updated_at")

  @@map("customers")
}

model Contact {
  id         String    @id @default(uuid())
  name       String
  email      String?
  phone      String?
  title      String?
  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leads      Lead[]
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt      @map("updated_at")

  @@index([customerId])
  @@map("contacts")
}

model Lead {
  id              String     @id @default(uuid())
  title           String     @db.VarChar(200)
  contactId       String?    @map("contact_id")
  contact         Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source          LeadSource
  status          LeadStatus @default(NEW)
  estimatedValue  Decimal?   @db.Decimal(18, 2) @map("estimated_value")
  currency        String     @default("VND")
  assigneeId      String     @map("assignee_id")
  notes           String?    @db.Text
  convertedDealId String?    @map("converted_deal_id")
  convertedAt     DateTime?  @map("converted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt      @map("updated_at")

  @@index([assigneeId])
  @@index([status])
  @@map("leads")
}

model Deal {
  id                String    @id @default(uuid())
  code              String    @unique
  title             String    @db.VarChar(200)
  customerId        String    @map("customer_id")
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  stage             DealStage @default(QUALIFICATION)
  value             Decimal?  @db.Decimal(18, 2)
  currency          String    @default("VND")
  probability       Int?
  expectedCloseDate DateTime? @map("expected_close_date")
  assigneeId        String    @map("assignee_id")
  wonAt             DateTime? @map("won_at")
  lostAt            DateTime? @map("lost_at")
  lostReason        String?   @map("lost_reason")
  projectId         String?   @map("project_id")
  processInstanceId String?   @map("process_instance_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt      @map("updated_at")

  @@index([customerId])
  @@index([stage])
  @@index([assigneeId])
  @@map("deals")
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL
  EVENT
  COLD_OUTREACH
  OTHER

  @@map("lead_source")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST

  @@map("lead_status")
}

enum DealStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST

  @@map("deal_stage")
}

// ─── CRM Activities ──────────────────────────────────────────────────────────

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE

  @@map("activity_type")
}

model CrmActivity {
  id              String       @id @default(uuid())
  type            ActivityType
  subject         String       @db.VarChar(200)
  content         String?      @db.Text
  customerId      String?      @map("customer_id")
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealId          String?      @map("deal_id")
  contactId       String?      @map("contact_id")
  leadId          String?      @map("lead_id")
  scheduledAt     DateTime?    @map("scheduled_at")
  completedAt     DateTime?    @map("completed_at")
  duration        Int?
  outcome         String?      @db.Text
  nextAction      String?      @map("next_action") @db.VarChar(300)
  nextActionDueAt DateTime?    @map("next_action_due_at")
  createdById     String       @map("created_by_id")
  createdBy       User         @relation("CrmActivityCreator", fields: [createdById], references: [id])
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt      @map("updated_at")

  @@index([customerId])
  @@index([dealId])
  @@index([leadId])
  @@index([contactId])
  @@index([createdById])
  @@map("crm_activities")
}

// ─── Client Contracts ─────────────────────────────────────────────────────────

model ClientContract {
  id          String               @id @default(uuid())
  contractNo  String?              @unique @map("contract_no")
  title       String               @db.VarChar(200)
  customerId  String               @map("customer_id")
  dealId      String?              @map("deal_id")
