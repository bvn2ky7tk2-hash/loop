  notes      String?
  createdAt  DateTime        @default(now()) @map("created_at")
  contract   ClientContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_milestones")
}

enum ClientContractType {
  SERVICE
  PRODUCT
  SUPPORT
  SLA
  OTHER

  @@map("client_contract_type")
}

enum ClientContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("client_contract_status")
}

enum MilestoneStatus {
  PENDING
  INVOICED
  PAID

  @@map("milestone_status")
}

// ─── Phase 3A: Invoicing ──────────────────────────────────────────────────────

model Invoice {
  id                String        @id @default(uuid())
  code              String        @unique
  type              InvoiceType
  customerId        String?       @map("customer_id")
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId         String?       @map("project_id")
  issueDate         DateTime      @map("issue_date") @db.Date
  dueDate           DateTime      @map("due_date")   @db.Date
  status            InvoiceStatus @default(DRAFT)
  subtotal          Decimal       @db.Decimal(18, 2)
  taxAmount         Decimal       @db.Decimal(18, 2) @default(0) @map("tax_amount")
  totalAmount       Decimal       @db.Decimal(18, 2) @map("total_amount")
  currency          String        @default("VND")
  notes             String?       @db.Text
  paidAt            DateTime?     @map("paid_at")
  processInstanceId String?       @map("process_instance_id")
  createdById       String        @map("created_by_id")
  items             InvoiceItem[]
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt      @map("updated_at")

  @@index([status])
  @@index([customerId])
  @@index([projectId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(18, 2) @map("unit_price")
  amount      Decimal @db.Decimal(18, 2)
  taxRate     Decimal @db.Decimal(5, 2)  @default(0) @map("tax_rate")

  @@index([invoiceId])
  @@map("invoice_items")
}

enum InvoiceType {
  SALES
  PURCHASE

  @@map("invoice_type")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED

  @@map("invoice_status")
}

// ─── Phase 3B: Recruitment ────────────────────────────────────────────────────

model JobOpening {
  id           String        @id @default(uuid())
  code         String        @unique
  title        String        @db.VarChar(200)
  orgUnitId    String        @map("org_unit_id")
  level        EmployeeLevel @default(JUNIOR)
  headcount    Int           @default(1)
  status       JobStatus     @default(OPEN)
  requirements String?       @db.Text
  salaryFrom   Decimal?      @db.Decimal(18, 2) @map("salary_from")
  salaryTo     Decimal?      @db.Decimal(18, 2) @map("salary_to")
  closedAt     DateTime?     @map("closed_at")
  candidates   Candidate[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt      @map("updated_at")

  @@index([orgUnitId, status])
  @@map("job_openings")
}

model Candidate {
  id                String         @id @default(uuid())
  name              String
  email             String?
  phone             String?
  cvStoragePath     String?        @map("cv_storage_path")
  jobOpeningId      String         @map("job_opening_id")
  jobOpening        JobOpening     @relation(fields: [jobOpeningId], references: [id], onDelete: Restrict)
  stage             CandidateStage @default(APPLIED)
  assigneeId        String?        @map("assignee_id")
  source            LeadSource?
  expectedSalary    Decimal?       @db.Decimal(18, 2) @map("expected_salary")
  interviews        Interview[]
  employeeId        String?        @unique @map("employee_id")
  processInstanceId String?        @map("process_instance_id")
  notes             String?        @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt      @map("updated_at")

  @@index([jobOpeningId, stage])
  @@index([assigneeId])
  @@map("candidates")
}

model Interview {
  id           String          @id @default(uuid())
  candidateId  String          @map("candidate_id")
  candidate    Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type         InterviewType
  scheduledAt  DateTime        @map("scheduled_at")
  location     String?
  meetingUrl   String?         @map("meeting_url")
  interviewers String[]
  result       InterviewResult @default(PENDING)
  score        Int?
  notes        String?         @db.Text
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt      @map("updated_at")

  @@index([candidateId])
  @@map("interviews")
}

enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED

  @@map("job_status")
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED

  @@map("candidate_stage")
}

enum InterviewType {
  PHONE
  TECHNICAL
  HR
  FINAL

  @@map("interview_type")
}

enum InterviewResult {
  PASS
  FAIL
  PENDING

  @@map("interview_result")
}

// ─── Epic 21: Asset Management ────────────────────────────────────────────────

model Asset {
  id                String             @id @default(uuid())
  code              String             @unique @db.VarChar(50)
  name              String             @db.VarChar(200)
  category          AssetCategory
  brand             String?            @db.VarChar(100)
  model             String?            @db.VarChar(100)
  serialNumber      String?            @map("serial_number") @db.VarChar(100)
  orgUnitId         String?            @map("org_unit_id")
  orgUnit           OrgUnit?           @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  status            AssetStatus        @default(AVAILABLE)
  purchaseDate      DateTime?          @map("purchase_date") @db.Date
  purchasePrice     Decimal?           @map("purchase_price") @db.Decimal(18, 2)
  depreciationYears Int?               @map("depreciation_years")
  notes             String?            @db.Text
  assignments       AssetAssignment[]
  maintenanceLogs   AssetMaintenance[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([orgUnitId, status], name: "idx_assets_org_status")
  @@map("assets")
}

model AssetAssignment {
  id          String    @id @default(uuid())
  assetId     String    @map("asset_id")
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  returnedAt  DateTime? @map("returned_at")
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([assetId], name: "idx_asset_assignments_asset_id")
  @@index([employeeId], name: "idx_asset_assignments_employee_id")
  @@map("asset_assignments")
}

model AssetMaintenance {
  id          String   @id @default(uuid())
  assetId     String   @map("asset_id")
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type        String   @db.VarChar(50)
  performedAt DateTime @map("performed_at") @db.Date
  cost        Decimal? @db.Decimal(18, 2)
  performedBy String?  @map("performed_by") @db.VarChar(200)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([assetId])
  @@map("asset_maintenance")
}

enum AssetCategory {
  LAPTOP
  DESKTOP
  PHONE
  SERVER
  PERIPHERAL
  SOFTWARE
  FURNITURE
  VEHICLE
  OTHER

  @@map("asset_category")
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  RETIRED

  @@map("asset_status")
}

// ─── Accounting (double-entry) ────────────────────────────────────────────────

model ChartOfAccount {
  id           String        @id @default(uuid())
  code         String        @unique @db.VarChar(20)
  name         String        @db.VarChar(200)
  type         AccountType
  parentCode   String?       @map("parent_code") @db.VarChar(20)
  isActive     Boolean       @default(true) @map("is_active")
  journalLines JournalLine[]
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([type])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id          String        @id @default(uuid())
  date        DateTime      @db.Date
  description String        @db.VarChar(500)
  reference   String?       @db.VarChar(100)
  lines       JournalLine[]
  createdById String        @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([date])
  @@map("journal_entries")
}

model JournalLine {
  id          String         @id @default(uuid())
  entryId     String         @map("entry_id")
  entry       JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountCode String         @map("account_code") @db.VarChar(20)
  account     ChartOfAccount @relation(fields: [accountCode], references: [code])
  debit       Decimal        @default(0) @db.Decimal(18, 2)
  credit      Decimal        @default(0) @db.Decimal(18, 2)
  description String?        @db.VarChar(200)

  @@index([entryId])
  @@index([accountCode])
  @@map("journal_lines")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@map("account_type")
}

// ─── HR Extensions: Training + Performance Review ────────────────────────────

model TrainingProgram {
  id            String           @id @default(uuid())
  title         String           @db.VarChar(200)
  type          String           @db.VarChar(50)
  durationHours Int              @map("duration_hours")
  description   String?          @db.Text
  records       TrainingRecord[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt      @map("updated_at")

  @@map("training_programs")
}

model TrainingRecord {
  id          String          @id @default(uuid())
  programId   String          @map("program_id")
  program     TrainingProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  employeeId  String          @map("employee_id")
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  startDate   DateTime        @map("start_date") @db.Date
  endDate     DateTime?       @map("end_date")   @db.Date
  status      TrainingStatus  @default(SCHEDULED)
  score       Decimal?        @db.Decimal(5, 2)
  certificate String?         @db.VarChar(500)
  notes       String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt      @map("updated_at")

  @@index([employeeId, status])
  @@index([programId])
  @@map("training_records")
}

model PerformanceReview {
  id                String       @id @default(uuid())
  employeeId        String       @map("employee_id")
  employee          Employee     @relation("ReviewSubject", fields: [employeeId], references: [id], onDelete: Restrict)
  reviewerId        String       @map("reviewer_id")
  reviewer          Employee     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  period            String       @db.VarChar(20)
  score             Decimal?     @db.Decimal(3, 1)
  strengths         String?      @db.Text
  improvements      String?      @db.Text
  goals             String?      @db.Text
  status            ReviewStatus @default(DRAFT)
  processInstanceId String?      @map("process_instance_id")
  submittedAt       DateTime?    @map("submitted_at")
  approvedAt        DateTime?    @map("approved_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt      @map("updated_at")

  @@unique([employeeId, period])
  @@index([reviewerId])
  @@index([status])
  @@map("performance_reviews")
}

enum TrainingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("training_status")
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  APPROVED

  @@map("review_status")
}

// ─── Epic 22: Payroll Compliance ──────────────────────────────────────────────

model InsuranceConfig {
  id                  String   @id @default(uuid())
  tenantId            String?  @map("tenant_id")
  effectiveFrom       DateTime @map("effective_from") @db.Date
  bhxhEmployeeRate    Decimal  @map("bhxh_employee_rate") @db.Decimal(5, 4)
  bhytEmployeeRate    Decimal  @map("bhyt_employee_rate") @db.Decimal(5, 4)
  bhtnEmployeeRate    Decimal  @map("bhtn_employee_rate") @db.Decimal(5, 4)
  bhxhEmployerRate    Decimal  @map("bhxh_employer_rate") @db.Decimal(5, 4)
  bhytEmployerRate    Decimal  @map("bhyt_employer_rate") @db.Decimal(5, 4)
  bhtnEmployerRate    Decimal  @map("bhtn_employer_rate") @db.Decimal(5, 4)
  tnldRate            Decimal  @map("tnld_rate") @db.Decimal(5, 4)
  bhxhCeilingMultiple Int      @default(20) @map("bhxh_ceiling_multiple")
  wageBase            Decimal  @map("wage_base") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([tenantId, effectiveFrom])
  @@map("insurance_configs")
}

model TaxBracket {
  id            String   @id @default(uuid())
  tenantId      String?  @map("tenant_id")
  name          String
  effectiveFrom DateTime @map("effective_from") @db.Date
  brackets      Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([tenantId, effectiveFrom])
  @@map("tax_brackets")
}

model TaxDeductionConfig {
  id                 String   @id @default(uuid())
  tenantId           String?  @map("tenant_id")
  effectiveFrom      DateTime @map("effective_from") @db.Date
  selfDeduction      Decimal  @map("self_deduction") @db.Decimal(15, 2)
  dependentDeduction Decimal  @map("dependent_deduction") @db.Decimal(15, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([tenantId, effectiveFrom])
  @@map("tax_deduction_configs")
}

model WageZoneConfig {
  id            String   @id @default(uuid())
  tenantId      String?  @map("tenant_id")
  effectiveFrom DateTime @map("effective_from") @db.Date
  zone1         Decimal  @db.Decimal(12, 2)
  zone2         Decimal  @db.Decimal(12, 2)
  zone3         Decimal  @db.Decimal(12, 2)
  zone4         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([tenantId, effectiveFrom])
  @@map("wage_zone_configs")
}

model EmployeeTaxProfile {
  employeeId      String          @id @map("employee_id")
  taxId           String?         @map("tax_id")
  residencyStatus ResidencyStatus @default(RESIDENT) @map("residency_status")
  wageZone        Int             @default(1) @map("wage_zone")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dependents      Dependent[]

  @@map("employee_tax_profiles")
}

model Dependent {
  id             String             @id @default(uuid())
  employeeId     String             @map("employee_id")
  name           String
  relationship   String
  taxId          String?            @map("tax_id")
  registeredFrom DateTime           @map("registered_from") @db.Date
  registeredTo   DateTime?          @map("registered_to") @db.Date
  createdAt      DateTime           @default(now()) @map("created_at")
  taxProfile     EmployeeTaxProfile @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@index([employeeId])
  @@map("dependents")
}

model AllowanceType {
  id               String              @id @default(uuid())
  name             String              @unique
  defaultAmount    Decimal             @map("default_amount") @db.Decimal(12, 2)
  isBhxhExempt     Boolean             @default(true) @map("is_bhxh_exempt")
  isPitExempt      Boolean             @default(false) @map("is_pit_exempt")
  pitExemptCeiling Decimal?            @map("pit_exempt_ceiling") @db.Decimal(12, 2)
  isActive         Boolean             @default(true) @map("is_active")
  createdAt        DateTime            @default(now()) @map("created_at")
  employeeAllowances EmployeeAllowance[]
  salaryColumns    SalaryColumn[]

  @@map("allowance_types")
}

model BonusType {
  id           String          @id @default(uuid())
  name         String          @unique
  isBhxhExempt Boolean         @default(true) @map("is_bhxh_exempt")
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  employeeBonuses EmployeeBonus[]

  @@map("bonus_types")
}

model EmployeeBonus {
  id              String        @id @default(uuid())
  payrollRecordId String        @map("payroll_record_id")
  bonusTypeId     String        @map("bonus_type_id")
  amount          Decimal       @db.Decimal(15, 2)
  note            String?
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  bonusType       BonusType     @relation(fields: [bonusTypeId], references: [id])

  @@unique([payrollRecordId, bonusTypeId])
  @@map("employee_bonuses")
}

model EmployeeYearlyTaxSummary {
  id               String   @id @default(uuid())
  employeeId       String   @map("employee_id")
  year             Int
  ytdGross         Decimal  @default(0) @map("ytd_gross") @db.Decimal(15, 2)
  ytdTaxableIncome Decimal  @default(0) @map("ytd_taxable_income") @db.Decimal(15, 2)
  ytdPitPaid       Decimal  @default(0) @map("ytd_pit_paid") @db.Decimal(15, 2)
  ytdBhxhEmployee  Decimal  @default(0) @map("ytd_bhxh_employee") @db.Decimal(15, 2)
  updatedAt        DateTime @updatedAt @map("updated_at")
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
  @@index([employeeId, year])
  @@map("employee_yearly_tax_summaries")
}

model EmployeeAllowance {
  id              String        @id @default(uuid())
  payrollRecordId String        @map("payroll_record_id")
  allowanceTypeId String        @map("allowance_type_id")
  amount          Decimal       @db.Decimal(12, 2)
  overrideNote    String?       @map("override_note")
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  allowanceType   AllowanceType @relation(fields: [allowanceTypeId], references: [id])

  @@unique([payrollRecordId, allowanceTypeId])
  @@map("employee_allowances")
}

model SalaryColumn {
  id               String             @id @default(uuid())
  tenantId         String?            @map("tenant_id")
  name             String
  type             SalaryColumnType
  source           SalaryColumnSource
  allowanceTypeId  String?            @map("allowance_type_id")
  fixedValue       Decimal?           @map("fixed_value") @db.Decimal(15, 2)
  formula          String?
  isBhxhExempt     Boolean            @default(false) @map("is_bhxh_exempt")
  isPitExempt      Boolean            @default(false) @map("is_pit_exempt")
  pitExemptCeiling Decimal?           @map("pit_exempt_ceiling") @db.Decimal(12, 2)
  sortOrder        Int                @default(0) @map("sort_order")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  allowanceType    AllowanceType?     @relation(fields: [allowanceTypeId], references: [id])

  @@index([tenantId, isActive])
  @@map("salary_columns")
}

enum PayrollPeriodType {
  REGULAR
  ADJUSTMENT

  @@map("payroll_period_type")
}

enum ResidencyStatus {
  RESIDENT
  NON_RESIDENT

  @@map("residency_status")
}

enum SalaryColumnType {
  EARNING
  DEDUCTION

  @@map("salary_column_type")
}

enum SalaryColumnSource {
  CONTRACT_SALARY
  ALLOWANCE_TYPE
  FIXED_VALUE
  FORMULA

  @@map("salary_column_source")
}

// ─── OKR / KPI ───────────────────────────────────────────────────────────────

enum OkrStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("okr_status")
}

enum OkrCycle {
  Q1
  Q2
  Q3
  Q4
  H1
  H2
  ANNUAL

  @@map("okr_cycle")
}

enum KpiFrequency {
  MONTHLY
  QUARTERLY
  YEARLY

  @@map("kpi_frequency")
}

model OkrObjective {
  id          String      @id @default(uuid())
  title       String      @db.VarChar(300)
  description String?     @db.Text
  cycle       OkrCycle
  year        Int
  ownerId     String      @map("owner_id")
  owner       User        @relation("OkrObjectiveOwner", fields: [ownerId], references: [id])
  orgUnitId   String?     @map("org_unit_id")
  status      OkrStatus   @default(DRAFT)
  keyResults  OkrKeyResult[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt      @map("updated_at")

  @@index([ownerId])
  @@index([year, cycle])
  @@map("okr_objectives")
}

model OkrKeyResult {
  id           String       @id @default(uuid())
  objectiveId  String       @map("objective_id")
  objective    OkrObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  title        String       @db.VarChar(300)
  unit         String       @default("")
  startValue   Decimal      @default(0) @db.Decimal(18, 2) @map("start_value")
  targetValue  Decimal      @db.Decimal(18, 2) @map("target_value")
  currentValue Decimal      @default(0) @db.Decimal(18, 2) @map("current_value")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt      @map("updated_at")

  @@index([objectiveId])
  @@map("okr_key_results")
}

model KpiMetric {
  id          String       @id @default(uuid())
  name        String       @db.VarChar(200)
  description String?      @db.Text
  unit        String       @default("")
  targetValue Decimal?     @db.Decimal(18, 2) @map("target_value")
  frequency   KpiFrequency @default(MONTHLY)
  orgUnitId   String?      @map("org_unit_id")
  isActive    Boolean      @default(true) @map("is_active")
  records     KpiRecord[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt      @map("updated_at")

  @@map("kpi_metrics")
}

model KpiRecord {
  id        String    @id @default(uuid())
  metricId  String    @map("metric_id")
  metric    KpiMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  period    String    @db.VarChar(20)
  value     Decimal   @db.Decimal(18, 2)
  notes     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([metricId, period])
  @@index([metricId])
  @@map("kpi_records")
}
