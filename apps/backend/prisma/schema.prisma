// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── User Groups (Nhóm người dùng) ────────────────────────────────────────────

model UserGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions GroupPermission[]
  members     GroupMembership[]
  orgAccess   GroupOrgAccess[]

  @@map("user_groups")
}

model GroupPermission {
  groupId      String @map("group_id")
  permCode     String @map("perm_code")

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, permCode])
  @@map("group_permissions")
}

model GroupMembership {
  userId  String @map("user_id")
  groupId String @map("group_id")

  user  User      @relation(fields: [userId],  references: [id], onDelete: Cascade)
  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("group_memberships")
}

model GroupOrgAccess {
  groupId         String  @map("group_id")
  orgUnitId       String  @map("org_unit_id")
  includeChildren Boolean @default(true) @map("include_children")

  group   UserGroup @relation(fields: [groupId],   references: [id], onDelete: Cascade)
  orgUnit OrgUnit   @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@id([groupId, orgUnitId])
  @@map("group_org_access")
}

// ─── Phase 2: HR — Contracts ──────────────────────────────────────────────────

model Contract {
  id             String         @id @default(uuid())
  employeeId     String         @map("employee_id")
  type           ContractType   @default(FULL_TIME)
  status         ContractStatus @default(ACTIVE)
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime?      @map("end_date") @db.Date
  salaryMonthly  Decimal        @map("salary_monthly") @db.Decimal(15, 2)
  currency       BudgetCurrency @default(VND)
  note           String?
  signedAt       DateTime?      @map("signed_at") @db.Date
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("contracts")
}

enum ContractType {
  FULL_TIME
  PART_TIME
  PROBATION
  FREELANCE

  @@map("contract_type")
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED

  @@map("contract_status")
}

// ─── Phase 2: HR — Leave Management ──────────────────────────────────────────

model LeaveType {
  id                   String         @id @default(uuid())
  name                 String         @unique
  maxDaysPerYear       Int            @map("max_days_per_year")
  isPaid               Boolean        @default(true) @map("is_paid")
  color                String         @default("#2563EB")
  isActive             Boolean        @default(true) @map("is_active")
  processDefinitionKey String?        @map("process_definition_key")
  createdAt            DateTime       @default(now()) @map("created_at")
  requests             LeaveRequest[]
  balances             LeaveBalance[]

  @@map("leave_types")
}

model LeaveRequest {
  id                String           @id @default(uuid())
  employeeId        String           @map("employee_id")
  leaveTypeId       String           @map("leave_type_id")
  startDate         DateTime         @map("start_date") @db.Date
  endDate           DateTime         @map("end_date") @db.Date
  days              Decimal          @db.Decimal(5, 1)
  reason            String?
  status            LeaveStatus      @default(PENDING)
  approvedById      String?          @map("approved_by_id")
  approvedAt        DateTime?        @map("approved_at")
  rejectedReason    String?          @map("rejected_reason")
  processInstanceId String?          @map("process_instance_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType         LeaveType        @relation(fields: [leaveTypeId], references: [id])
  approvedBy        User?            @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  processInstance   ProcessInstance? @relation(fields: [processInstanceId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([processInstanceId])
  @@map("leave_requests")
}

model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String    @map("employee_id")
  leaveTypeId String    @map("leave_type_id")
  year        Int
  totalDays   Decimal   @map("total_days") @db.Decimal(5, 1)
  usedDays    Decimal   @default(0) @map("used_days") @db.Decimal(5, 1)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("leave_status")
}

// ─── Phase 2: HR — Payroll ────────────────────────────────────────────────────

model PayrollPeriod {
  id                    String            @id @default(uuid())
  name                  String
  startDate             DateTime          @map("start_date") @db.Date
  endDate               DateTime          @map("end_date") @db.Date
  status                PayrollStatus     @default(DRAFT)
  type                  PayrollPeriodType @default(REGULAR) @map("type")
  adjustmentForPeriodId String?           @map("adjustment_for_period_id")
  processedById         String?           @map("processed_by_id")
  processedAt           DateTime?         @map("processed_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  records               PayrollRecord[]
  processedBy           User?             @relation("PayrollProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  adjustmentFor         PayrollPeriod?    @relation("AdjustmentPeriod", fields: [adjustmentForPeriodId], references: [id])
  adjustments           PayrollPeriod[]   @relation("AdjustmentPeriod")

  @@map("payroll_periods")
}

model PayrollRecord {
  id                  String        @id @default(uuid())
  periodId            String        @map("period_id")
  employeeId          String        @map("employee_id")
  workDays            Decimal       @map("work_days") @db.Decimal(5, 1)
  leaveDays           Decimal       @default(0) @map("leave_days") @db.Decimal(5, 1)
  paidLeaveDays       Decimal       @default(0) @map("paid_leave_days") @db.Decimal(5, 1)
  unpaidLeaveDays     Decimal       @default(0) @map("unpaid_leave_days") @db.Decimal(5, 1)
  overtimeHours       Decimal       @default(0) @map("overtime_hours") @db.Decimal(7, 2)
  overtimePayBreakdown Json?        @map("overtime_pay_breakdown")
  baseSalary          Decimal       @default(0) @map("base_salary") @db.Decimal(15, 2)
  grossSalary         Decimal       @default(0) @map("gross_salary") @db.Decimal(15, 2)
  overtimePay         Decimal       @default(0) @map("overtime_pay") @db.Decimal(15, 2)
  allowances          Decimal       @default(0) @db.Decimal(15, 2)
  deductions          Decimal       @default(0) @db.Decimal(15, 2)
  bonus               Decimal       @default(0) @db.Decimal(15, 2)
  bhxhEmployee        Decimal       @default(0) @map("bhxh_employee") @db.Decimal(15, 2)
  bhytEmployee        Decimal       @default(0) @map("bhyt_employee") @db.Decimal(15, 2)
  bhtnEmployee        Decimal       @default(0) @map("bhtn_employee") @db.Decimal(15, 2)
  bhxhEmployer        Decimal       @default(0) @map("bhxh_employer") @db.Decimal(15, 2)
  bhytEmployer        Decimal       @default(0) @map("bhyt_employer") @db.Decimal(15, 2)
  bhtnEmployer        Decimal       @default(0) @map("bhtn_employer") @db.Decimal(15, 2)
  tnldEmployer        Decimal       @default(0) @map("tnld_employer") @db.Decimal(15, 2)
  taxableIncome       Decimal       @default(0) @map("taxable_income") @db.Decimal(15, 2)
  selfDeduction       Decimal       @default(0) @map("self_deduction") @db.Decimal(15, 2)
  dependentDeduction  Decimal       @default(0) @map("dependent_deduction") @db.Decimal(15, 2)
  dependentCount      Int           @default(0) @map("dependent_count")
  pitAmount           Decimal       @default(0) @map("pit_amount") @db.Decimal(15, 2)
  totalLaborCost      Decimal       @default(0) @map("total_labor_cost") @db.Decimal(15, 2)
  netSalary           Decimal       @default(0) @map("net_salary") @db.Decimal(15, 2)
  payslipPath         String?       @map("payslip_path")
  configSnapshot      Json?         @map("config_snapshot")
  overrideNote        String?       @map("override_note")
  note                String?
  period              PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee            Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeAllowances  EmployeeAllowance[]
  employeeBonuses     EmployeeBonus[]

  @@unique([periodId, employeeId])
  @@index([employeeId, periodId])
  @@index([periodId])
  @@map("payroll_records")
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  REVIEWED
  APPROVED
  PAID

  @@map("payroll_status")
}

// ─── Phase 2: PM — Expense Management ────────────────────────────────────────

model Expense {
  id                String           @id @default(uuid())
  projectId         String?          @map("project_id")
  submittedById     String           @map("submitted_by_id")
  title             String
  category          ExpenseCategory  @default(OTHER)
  totalAmount       Decimal          @map("total_amount") @db.Decimal(15, 2)
  currency          BudgetCurrency   @default(VND)
  status            ExpenseStatus    @default(PENDING)
  approvedById      String?          @map("approved_by_id")
  approvedAt        DateTime?        @map("approved_at")
  rejectedReason    String?          @map("rejected_reason")
  processInstanceId String?          @map("process_instance_id")
  note              String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  items             ExpenseItem[]
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
