# Database
DATABASE_URL=postgresql://loop:loop_password@localhost:5432/loop_db

# ── Connection pool (QUAN TRỌNG khi scale ngang nhiều instance) ──
# Tổng kết nối tới Postgres = DB_POOL_MAX × (số instance backend).
# PHẢI ≤ postgres max_connections (mặc định 100), chừa ~20 cho admin/replication.
# Công thức: DB_POOL_MAX = floor((max_connections - 20) / số_instance).
#   1 instance, max_connections=100 → để 20 (mặc định an toàn).
#   5 instance, max_connections=100 → DB_POOL_MAX=15.
# Nếu > 5 instance → DÙNG PgBouncer (transaction pooling) thay vì tăng pool.
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — change these in production
JWT_SECRET=change_me_in_production_32chars_min
JWT_REFRESH_SECRET=change_refresh_in_production_32chars

# CORS (comma-separated origins for production)
# CORS_ORIGIN=https://loop.internal

# SMTP (optional — for email notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=noreply@loop.internal

# FCM (optional — for mobile push notifications)
# FCM_SERVICE_ACCOUNT={"type":"service_account",...}

# MinIO — File storage (bug attachments, etc.)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=loop_minio
MINIO_SECRET_KEY=loop_minio_secret
MINIO_BUCKET=loop-bug-attachments
# URL công khai để trình duyệt tải ảnh
MINIO_PUBLIC_URL=

# Multi-tenancy
DEPLOYMENT_MODE=saas
TENANT_ENFORCEMENT=true
DEFAULT_TENANT_ID=

# Demo Mode (set true để bật chức năng snapshot/restore)
DEMO_MODE=false
DEMO_SNAPSHOTS_DIR=/path/to/demo-snapshots
