{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "seed:full": "node prisma/seed-full.js",
    "seed:timesheet": "node prisma/seed-timesheet.js",
    "seed:mega": "node prisma/seed-mega.js",
    "seed:500": "node prisma/seed-500.js",
    "seed:patch": "node prisma/seed-patch.js",
    "seed:client-contracts": "node prisma/seed-client-contracts.js",
    "seed:crm-activities": "node prisma/seed-crm-activities.js",
    "seed:skills": "node prisma/seed-skills.js",
    "seed:payroll": "npx tsx prisma/seed-payroll.ts",
    "seed:payroll-demo": "npx tsx prisma/seed-payroll-demo.ts",
    "seed:okr": "node prisma/seed-okr.js",
    "seed:forecast": "node prisma/seed-forecast.js",
    "seed:kb": "node prisma/seed-kb.js",
    "seed:portal": "node prisma/seed-portal.js",
    "seed:procurement": "node prisma/seed-procurement.js",
    "seed:notifications": "node prisma/seed-notifications.js",
    "seed:audit-logs": "node prisma/seed-audit-logs.js",
    "seed:scheduled-reports": "node prisma/seed-scheduled-reports.js",
    "seed:automation": "node prisma/seed-automation.js",
    "seed:webhooks": "node prisma/seed-webhooks.js",
    "seed:feed": "node prisma/seed-feed.js",
    "seed:module-config": "node prisma/seed-module-config.js",
    "seed:rooms": "node prisma/seed-rooms.js",
    "seed:vehicles": "node prisma/seed-vehicles.js"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@loop/shared": "workspace:*",
    "@nestjs/bull": "^11.0.4",
