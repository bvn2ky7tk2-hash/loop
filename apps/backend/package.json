    "@prisma/client-runtime-utils": "^7.8.0",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.20.0",
    "bcrypt": "^6.0.0",
    "bpmn-engine": "^25.0.1",
    "bullmq": "^5.77.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.20",
    "exceljs": "^4.4.0",
