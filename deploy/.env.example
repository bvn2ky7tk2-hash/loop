# Loop ERP Environment Variables - Example
# Copy to .env and update values for your server

# ==================================
# Database
# ==================================
DATABASE_URL="postgresql://loop_user:loop_password@localhost:5432/loop_db"
# Example: postgresql://user:password@db-host:5432/database-name

# ==================================
# JWT / Auth
# ==================================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRY="24h"
REFRESH_TOKEN_EXPIRY="7d"

# ==================================
# Server
# ==================================
PORT=3000
NODE_ENV=production
# Options: development, staging, production

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"
# Change to: http://server-ip:5173 or https://yourdomain.com

# ==================================
# Email (Optional - for notifications)
# ==================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
# Gmail: Generate app password in account settings
# Outlook: use app-specific password

MAIL_FROM_NAME="Loop ERP"
MAIL_FROM_EMAIL="noreply@yourdomain.com"

# ==================================
# Storage / MinIO (Optional)
# ==================================
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"

# ==================================
# Logging
# ==================================
LOG_LEVEL="info"
# Options: debug, info, warn, error

# ==================================
# Rate Limiting
# ==================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Auth endpoints: 10 requests per 60 seconds
# Other endpoints: 100 requests per 60 seconds

# ==================================
# Timezone
# ==================================
TZ="Asia/Ho_Chi_Minh"
# Change to your server timezone

# ==================================
# Tenant / Multi-tenancy (if enabled)
# ==================================
MULTI_TENANT_ENABLED=false
# If true, need to setup tenant database schema

# ==================================
# Integration / External Services
# ==================================
# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=""

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==================================
# API Keys
# ==================================
API_KEY_SECRET="your-api-key-secret"

# ==================================
# Development (if NODE_ENV=development)
# ==================================
DEBUG=false
SEED_DATABASE=false
# Only set SEED_DATABASE=true once at initial setup
